const u16 PK_WAITING = 0;
const u16 PK_YIELDED = 1;
const u16 PK_EXITED  = 2;
const u16 PK_ENDED   = 3;

type pt {
    u16 lc;
};

// Inline lifecycle initializer
inline void pkInit(type pt p) {
    p.lc = 0;
}

// Coroutine operations, for use in task functions:
//
//     task blink(pt t) { ... yield(t); ... }
//
// The compiler generates these in place; they have no bodies. `t` is the
// task's state (its first parameter). The compiler numbers the resume points
// itself. Each returns from the task, so they are used as statements.

// Save the continuation and return PK_YIELDED. The next call resumes after
// the yield.
u16 yield(type pt p);

// If `cond` is false, return PK_WAITING; the next call re-tests `cond` here.
// Continue once it is true.
u16 waitUntil(type pt p, u32 cond);

// Reset the continuation and return PK_EXITED. The next call starts the task
// from the beginning.
u16 pkExit(type pt p);
