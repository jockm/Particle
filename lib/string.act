// =============================================================================
// Action Standard String Library (lib/string.act)
// Target: Particle 32-bit RISC Core
// Zero-heap, hardware-interoperable fixed-capacity null-terminated strings.
// Supports both direct function calls (string_*) and method syntax (s.*).
// =============================================================================

// Copy null-terminated payload from src into dst, respecting dst.capacity.
void stringCopy(string dst[], string src) {
    // No room even for the terminator (capacity - 1 would wrap around)
    if (dst.capacity == 0) {
        return;
    }
    u32 max_chars = dst.capacity - 1;
    u32 i = 0;
    while (i < max_chars) {
        u8 c = src[i];
        if (c == 0) {
            break;
        }
        dst[i] = c;
        i = i + 1;
    }
    dst[i] = 0;
}

// Append null-terminated payload from src to dst, respecting dst.capacity.
void stringConcat(string dst[], string src) {
    // No room even for the terminator (capacity - 1 would wrap around)
    if (dst.capacity == 0) {
        return;
    }
    u32 max_chars = dst.capacity - 1;
    u32 dst_idx = dst.len;
    u32 src_idx = 0;
    while (dst_idx < max_chars) {
        u8 c = src[src_idx];
        if (c == 0) {
            break;
        }
        dst[dst_idx] = c;
        dst_idx = dst_idx + 1;
        src_idx = src_idx + 1;
    }
    dst[dst_idx] = 0;
}

// Lexicographical comparison of two null-terminated strings.
// Returns 0 if identical, -1 if s1 < s2, 1 if s1 > s2.
s32 stringCompare(string s1, string s2) {
    u32 i = 0;
    while (1) {
        u8 c1 = s1[i];
        u8 c2 = s2[i];
        if (c1 != c2) {
            if (c1 > c2) {
                return 1;
            }
            return -1;
        }
        if (c1 == 0) {
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

// Boolean equality check. Returns 1 if s1 == s2, 0 otherwise.
u32 stringEquals(string s1, string s2) {
    u32 i = 0;
    while (1) {
        u8 c1 = s1[i];
        u8 c2 = s2[i];
        if (c1 != c2) {
            return 0;
        }
        if (c1 == 0) {
            return 1;
        }
        i = i + 1;
    }
    return 1;
}

// Search for the first occurrence of byte ch in string s.
// Returns 0-based index if found, -1 if not found.
s32 stringFind(string s, u8 ch) {
    u32 i = 0;
    while (1) {
        u8 c = s[i];
        if (c == ch) {
            return i;
        }
        if (c == 0) {
            return -1;
        }
        i = i + 1;
    }
    return -1;
}
