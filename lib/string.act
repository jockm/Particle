// =============================================================================
// Action Standard String Library (lib/string.act)
// Target: Particle 32-bit RISC Core
// Zero-heap, hardware-interoperable fixed-capacity null-terminated strings.
// The functions are methods of the built-in type string (s.find('c')), and
// those that compare two strings are also static functions of it
// (string.compare(a, b)). In a program made of packages this file is part
// of the prelude, loaded automatically.
// =============================================================================

// Copy null-terminated payload from src into this string, respecting its
// capacity.
void string.copy(string src) {
    // No room even for the terminator (capacity - 1 would wrap around)
    if (this.capacity == 0) {
        return;
    }
    u32 max_chars = this.capacity - 1;
    u32 i = 0;
    while (i < max_chars) {
        u8 c = src[i];
        if (c == 0) {
            break;
        }
        this[i] = c;
        i = i + 1;
    }
    this[i] = 0;
}

// Append null-terminated payload from src to this string, respecting its
// capacity.
void string.concat(string src) {
    // No room even for the terminator (capacity - 1 would wrap around)
    if (this.capacity == 0) {
        return;
    }
    u32 max_chars = this.capacity - 1;
    u32 dst_idx = this.len;
    u32 src_idx = 0;
    while (dst_idx < max_chars) {
        u8 c = src[src_idx];
        if (c == 0) {
            break;
        }
        this[dst_idx] = c;
        dst_idx = dst_idx + 1;
        src_idx = src_idx + 1;
    }
    this[dst_idx] = 0;
}

// Lexicographical comparison of two null-terminated strings.
// Returns 0 if identical, -1 if s1 < s2, 1 if s1 > s2.
static s32 string.compare(string s1, string s2) {
    u32 i = 0;
    while (1) {
        u8 c1 = s1[i];
        u8 c2 = s2[i];
        if (c1 != c2) {
            if (c1 > c2) {
                return 1;
            }
            return -1;
        }
        if (c1 == 0) {
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

// Compares this string with other, as string.compare(this, other).
s32 string.compare(string other) {
    return string.compare(this, other);
}

// Boolean equality check. Returns 1 if s1 == s2, 0 otherwise.
static u32 string.equals(string s1, string s2) {
    u32 i = 0;
    while (1) {
        u8 c1 = s1[i];
        u8 c2 = s2[i];
        if (c1 != c2) {
            return 0;
        }
        if (c1 == 0) {
            return 1;
        }
        i = i + 1;
    }
    return 1;
}

// Whether this string equals other, as string.equals(this, other).
u32 string.equals(string other) {
    return string.equals(this, other);
}

// Search for the first occurrence of byte ch in this string.
// Returns 0-based index if found, -1 if not found.
s32 string.find(u8 ch) {
    u32 i = 0;
    while (1) {
        u8 c = this[i];
        if (c == ch) {
            return i;
        }
        if (c == 0) {
            return -1;
        }
        i = i + 1;
    }
    return -1;
}
