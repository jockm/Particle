/////////////////////////////
// Parcore Conductor
//
// The Parcore Conductor is a software component that manages the execution of tasks and coordinates 
//   - System bringup
//   - Firmware initialization
//   - Firmware updates
//   - System monitoring
//   - Watchdog management
//   - System debugging
//   - System shutdown
//
// Its actions are independant of what CPU architecture is being implmented, or task being performed by the Parcore
// system.  For example the job of the conductor is the same whether the Parcore is running on a RISC-V CPU or an 
// x86-64 CPU, I/O processor, data acquisition task or a signal processing task.  The conductor is an independant 
// software component.
/////////////////////////////

import "lib/protokernel.act";

const bool NotDone = true;

type WatchdogState {
    u16 lc;          // Task continuation; must be the first field
    u32 checks;
}

type DebugState {
    u16 lc;          // Task continuation; must be the first field
    u32 reports;
}

void setup() {
    // TODO: Implement me
}

void firmwareUpdate() {
    // TODO: Implement me
}

task watchdog(WatchdogState t) {
    while (1) {
        t.checks += 1;

        // Perform watchdog checks here.
        yield(t);
    }
}

task debug(DebugState t) {
    while (1) {
        t.reports += 1;

        // Emit diagnostic information here.
        yield(t);
    }
}

void main() {
    WatchdogState watchdogState;
    DebugState debugState;

    setup();
    firmwareUpdate();

    while (NotDone) {
        watchdog(watchdogState);
        debug(debugState);
    }

    // If we somehow get here, something has gone very wrong.  Trap to the debugger.
    trap(15);

    // If we somehow get out of the trap 15, then reset the system.  This should never happen, but if it does, 
    // we want a defined behavior.
    trap(0);
}