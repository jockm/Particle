#!/usr/bin/env bash
# ==============================================================================
# pbuild - Particle Unified Build & Driver Script
# ==============================================================================
set -euo pipefail

SELF_SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SELF_SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SELF_SOURCE")" >/dev/null 2>&1 && pwd)"
    SELF_SOURCE="$(readlink "$SELF_SOURCE")"
    [[ "$SELF_SOURCE" != /* ]] && SELF_SOURCE="$DIR/$SELF_SOURCE"
done
PROJECT_ROOT="$(cd -P "$(dirname "$SELF_SOURCE")" >/dev/null 2>&1 && pwd)"

# Toolchain paths: the compiled Dart tools in build/tools
TOOL_DIR="${PROJECT_ROOT}/build/tools"
ACTION="${TOOL_DIR}/action"
CMD_PASM=("${TOOL_DIR}/pasm")
CMD_PASM_LINT=("${TOOL_DIR}/pasm_lint")
PSIM_CMD=("${TOOL_DIR}/psim")
LIB_DIR="${PROJECT_ROOT}/lib"

# Exits with a message if a required tool has not been built.
# Usage: require_tool <path> <make target>
require_tool() {
    if [ ! -x "$1" ]; then
        echo "Error: $(basename "$1") not found at '$1'. Build it with 'make $2'." >&2
        exit 1
    fi
}

print_usage() {
    cat << "HELP_TEXT"
Usage: pbuild [options] <source-file> [source-files...]

A unified build driver for Particle RISC (.asm) and Action (.act) programs.

Positional Arguments:
  source-file            One or more source files (.act and/or .asm)

Options:
  -o, --output <file>    Output binary path (default: build/<name>.<format>)
  -I, --include <dir>    Additional include search directory (repeatable)
  -D, --define <sym>     Predefine symbol: an Action const and a pasm define
                         (NAME or NAME=VALUE; repeatable)
      --format <fmt>     Output format: bin or hex (default: bin)
      --bounds-check, -fbounds-check
                         Enable array bounds checking (default)
      --no-bounds-check, -fno-bounds-check
                         Disable array bounds checking
      --sim              Run psim simulator after successful build
      --debug            Pass --debug to psim when running with --sim
      --base <addr>      Pass --base <addr> to psim when running with --sim
      --no-exit-on-reset Pass --no-exit-on-reset to psim when running with --sim
  -v, --verbose          Verbose output
  -h, --help             Show this help message and exit

Workflow:
  - If input is .act: Compiles to .asm, runs pasm_lint, then assembles to binary.
  - If input is .asm: Runs pasm_lint, then assembles to binary.
  - If --sim is specified: Runs build/tools/psim on the built binary.

Tools: build/tools/action, pasm, pasm_lint and psim (build with 'make tools').
HELP_TEXT
}

SOURCES=()
OUTPUT=""
FORMAT="bin"
VERBOSE=0
RUN_SIM=0
SIM_DEBUG=0
SIM_NO_EXIT_ON_RESET=0
SIM_BASE=""
INCLUDES=()
DEFINES=()
ACT16_FLAGS=()

if [ -d "$LIB_DIR" ]; then
    INCLUDES+=("-I" "$LIB_DIR")
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            print_usage
            exit 0
            ;;
        -v|--verbose)
            VERBOSE=1
            shift
            ;;
        -o|--output)
            if [[ -z "${2:-}" || "${2:-}" == -* ]]; then
                echo "Error: Option $1 requires an argument." >&2
                exit 1
            fi
            OUTPUT="$2"
            shift 2
            ;;
        -I|--include)
            if [[ -z "${2:-}" || "${2:-}" == -* ]]; then
                echo "Error: Option $1 requires an argument." >&2
                exit 1
            fi
            INCLUDES+=("-I" "$2")
            shift 2
            ;;
        -D|--define)
            if [[ -z "${2:-}" || "${2:-}" == -* ]]; then
                echo "Error: Option $1 requires an argument." >&2
                exit 1
            fi
            DEFINES+=("-D" "$2")
            shift 2
            ;;
        --format)
            if [[ -z "${2:-}" || "${2:-}" == -* ]]; then
                echo "Error: Option --format requires an argument (bin or hex)." >&2
                exit 1
            fi
            if [[ "$2" != "bin" && "$2" != "hex" ]]; then
                echo "Error: Invalid format '$2'. Allowed choices are 'bin' or 'hex'." >&2
                exit 1
            fi
            FORMAT="$2"
            shift 2
            ;;
        --bounds-check|-fbounds-check)
            ACT16_FLAGS+=("-fbounds-check")
            shift
            ;;
        --no-bounds-check|-fno-bounds-check)
            ACT16_FLAGS+=("-fno-bounds-check")
            shift
            ;;
        --sim)
            RUN_SIM=1
            shift
            ;;
        --debug)
            SIM_DEBUG=1
            shift
            ;;
        --no-exit-on-reset)
            SIM_NO_EXIT_ON_RESET=1
            shift
            ;;
        --base)
            if [[ -z "${2:-}" || "${2:-}" == -* ]]; then
                echo "Error: Option --base requires an argument." >&2
                exit 1
            fi
            SIM_BASE="$2"
            shift 2
            ;;
        -*)
            echo "Error: Unrecognized option '$1'." >&2
            echo "Run 'pbuild --help' for usage." >&2
            exit 1
            ;;
        *)
            SOURCES+=("$1")
            shift
            ;;
    esac
done

if [ "${#SOURCES[@]}" -eq 0 ]; then
    echo "Error: No source file specified." >&2
    print_usage >&2
    exit 1
fi

ACT_INPUTS=()
ASM_INPUTS=()

for s in "${SOURCES[@]}"; do
    if [ ! -f "$s" ]; then
        echo "Error: Source file not found: '$s'" >&2
        exit 1
    fi
    ext="${s##*.}"
    if [ "$ext" = "act" ]; then
        ACT_INPUTS+=("$s")
    elif [ "$ext" = "asm" ]; then
        ASM_INPUTS+=("$s")
    else
        echo "Error: Unsupported file type '.$ext' for '$s'. pbuild expects .act or .asm files." >&2
        exit 1
    fi
done

# Every tool this build needs must be present before anything runs
if [ "${#ACT_INPUTS[@]}" -gt 0 ]; then
    require_tool "$ACTION" action
fi
require_tool "${CMD_PASM_LINT[0]}" pasm-lint
require_tool "${CMD_PASM[0]}" pasm
if [ "$RUN_SIM" -eq 1 ]; then
    require_tool "${PSIM_CMD[0]}" psim
fi

PRIMARY_SOURCE="${SOURCES[0]}"
BASE_NAME="$(basename "$PRIMARY_SOURCE")"
STEM="${BASE_NAME%.*}"

if [ -z "$OUTPUT" ]; then
    OUTPUT="build/${STEM}.${FORMAT}"
fi

OUTPUT_DIR="$(dirname "$OUTPUT")"
if [ -n "$OUTPUT_DIR" ]; then
    mkdir -p "$OUTPUT_DIR"
fi

# Run a command quietly, printing its output only on failure or warning
run_step() {
    local label="$1"
    shift
    if [ "$VERBOSE" -eq 1 ]; then
        echo "==> [pbuild] $label"
        "$@"
    else
        local tmp
        local status=0
        tmp=$(mktemp)
        "$@" > "$tmp" 2>&1 || status=$?
        if [ "$status" -ne 0 ]; then
            echo "==> [pbuild] FAILED: $label" >&2
            cat "$tmp" >&2
            rm -f "$tmp"
            # Pass the tool's exit code along
            exit "$status"
        fi
        # If output contains warnings, show them
        if grep -qi "warning" "$tmp"; then
            cat "$tmp"
        fi
        rm -f "$tmp"
    fi
}

# 1. Action compilation step (if any .act files present)
ASM_SOURCES=()
if [ "${#ACT_INPUTS[@]}" -gt 0 ]; then
    ACT_ASM="build/${STEM}.asm"
    mkdir -p "$(dirname "$ACT_ASM")"
    run_step "Compiling Action: ${ACT_INPUTS[*]} -> $ACT_ASM" "$ACTION" "${ACT_INPUTS[@]}" -o "$ACT_ASM" ${INCLUDES[@]+"${INCLUDES[@]}"} ${ACT16_FLAGS[@]+"${ACT16_FLAGS[@]}"} ${DEFINES[@]+"${DEFINES[@]}"}
    ASM_SOURCES+=("$ACT_ASM")
fi

# Append any standalone .asm inputs
if [ "${#ASM_INPUTS[@]}" -gt 0 ]; then
    ASM_SOURCES+=("${ASM_INPUTS[@]}")
fi

# 2. Lint step (lint each ASM source file individually)
for src in "${ASM_SOURCES[@]}"; do
    run_step "Linting: $src" "${CMD_PASM_LINT[@]}" "$src" ${INCLUDES[@]+"${INCLUDES[@]}"}
done

# 3. Assemble step (pass all ASM sources to pasm)
run_step "Assembling: ${ASM_SOURCES[*]} -> $OUTPUT" "${CMD_PASM[@]}" "${ASM_SOURCES[@]}" ${INCLUDES[@]+"${INCLUDES[@]}"} -o "$OUTPUT" --format "$FORMAT" ${DEFINES[@]+"${DEFINES[@]}"}


if [ "$VERBOSE" -eq 1 ]; then
    echo "==> [pbuild] Successfully built $OUTPUT"
fi

# ------------------------------------------------------------------------------
# Simulator Invocation
# ------------------------------------------------------------------------------
if [ "$RUN_SIM" -eq 1 ]; then
    SIM_ARGS=()
    if [ "$SIM_DEBUG" -eq 1 ]; then
        SIM_ARGS+=("--debug")
    fi
    if [ -n "$SIM_BASE" ]; then
        SIM_ARGS+=("--base" "$SIM_BASE")
    fi
    if [ "$SIM_NO_EXIT_ON_RESET" -eq 1 ]; then
        SIM_ARGS+=("--no-exit-on-reset")
    fi

    sim_extra=""
    if [ "${#SIM_ARGS[@]}" -gt 0 ]; then
        sim_extra=" ${SIM_ARGS[*]}"
    fi

    if [ "$VERBOSE" -eq 1 ]; then
        echo "==> [pbuild] Running simulator: ${PSIM_CMD[*]} $OUTPUT$sim_extra"
    fi

    # psim's exit code says how the run ended (0: trap 0, 15: trap 15,
    # 16: psim error, 17: cycle limit, 18: PC ran past memory); pass it on
    sim_status=0
    "${PSIM_CMD[@]}" "$OUTPUT" ${SIM_ARGS[@]+"${SIM_ARGS[@]}"} || sim_status=$?
    exit "$sim_status"
fi
