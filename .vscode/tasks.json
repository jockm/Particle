{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Particle: Run ROHD Tests",
      "type": "shell",
      "command": "dart test",
      "options": {
        "cwd": "${workspaceFolder}/hdl/rohd"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$dart-test"
      ]
    },
    {
      "label": "Particle: Generate SystemVerilog",
      "type": "shell",
      "command": "dart run bin/generate.dart",
      "options": {
        "cwd": "${workspaceFolder}/hdl/rohd"
      },
      "group": "build",
      "problemMatcher": [
        "$dart-analyze"
      ]
    },
    {
      "label": "Particle: Assemble Current File (pasm)",
      "type": "shell",
      "command": "python3 tools/pasm.py \"${file}\" -I lib -o \"${workspaceFolder}/build/${fileBasenameNoExtension}.bin\" --format bin",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Particle: Compile ACT16 Current File (act16c)",
      "type": "shell",
      "command": "python3 tools/act16c.py \"${file}\" -o \"${workspaceFolder}/apps/asm/${fileBasenameNoExtension}.asm\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Particle: Assemble Comprehensive Test",
      "type": "shell",
      "command": "mkdir -p build && python3 tools/pasm.py apps/asm/comprehensive_test.asm -I lib -o build/test.bin --format bin",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Parcore: Run ROHD Tests",
      "type": "shell",
      "command": "dart test",
      "options": {
        "cwd": "${workspaceFolder}/hdl/parcore"
      },
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "problemMatcher": [
        "$dart-test"
      ]
    },
    {
      "label": "Parcore: Generate SystemVerilog",
      "type": "shell",
      "command": "dart run bin/generate_parcore.dart",
      "options": {
        "cwd": "${workspaceFolder}/hdl/parcore"
      },
      "group": "build",
      "problemMatcher": [
        "$dart-analyze"
      ]
    },
    {
      "label": "Parcore: Assemble All Stage Kernels",
      "type": "shell",
      "command": "mkdir -p build/parcore && for f in firmware/parcore/*.asm; do python3 tools/pasm.py \"$f\" -I lib -o \"build/parcore/$(basename \"$f\" .asm).bin\" --format bin; done",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}