{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Particle: Build Tools",
      "type": "shell",
      "command": "make tools",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Particle: Build Firmware and Applications",
      "type": "shell",
      "command": "make build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Particle: Assemble Current File",
      "type": "shell",
      "command": "make tools > /dev/null && mkdir -p build && build/tools/pasm \"${file}\" -I lib -I . -o \"build/${fileBasenameNoExtension}.bin\"",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Particle: Lint Current File",
      "type": "shell",
      "command": "make tools > /dev/null && build/tools/pasm_lint \"${file}\" -I lib -I .",
      "problemMatcher": []
    },
    {
      "label": "Action: Build and Run Current File in psim",
      "type": "shell",
      "command": "./pbuild \"${file}\" -o \"build/${fileBasenameNoExtension}.bin\" --sim",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Action: Build and Run Current File on This Computer (LLVM)",
      "type": "shell",
      "command": "./llbuild \"${file}\" --run",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Particle: Generate SystemVerilog (Core)",
      "type": "shell",
      "command": "make generate-particle",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Parcore: Generate SystemVerilog",
      "type": "shell",
      "command": "make generate-parcore",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "ULX3S: Build Bitstream",
      "type": "shell",
      "command": "make ulx3s-bit",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "ULX3S: Load Bitstream into the Board",
      "type": "shell",
      "command": "make ulx3s-prog",
      "problemMatcher": []
    },
    {
      "label": "ULX3S: Open the FTDI UART",
      "type": "shell",
      "command": "make ulx3s-term",
      "problemMatcher": []
    },
    {
      "label": "Particle: Run ROHD Tests",
      "type": "shell",
      "command": "make test-particle",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Parcore: Run ROHD Tests",
      "type": "shell",
      "command": "make test-parcore",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run Compiler and Language Server Tests",
      "type": "shell",
      "command": "make compiler-tests",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Run All Hardware and Simulator Tests",
      "type": "shell",
      "command": "make test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
