# Dart package manager build cache & toolchain artifacts
.dart_tool/
**/.dart_tool/

# macOS metadata, Finder state, and AppleDouble resource fork shadow files
.DS_Store
**/.DS_Store
._*
**/._*

# Build artifacts
**/*.bin
**/*.lst

# ROHD-generated SystemVerilog top-level outputs
hdl/particle/particle_top.sv
hdl/particle/*.sv

# Synthesis and PnR toolchain artifacts (Yosys / nextpnr)
hdl/particle/*.synth.json
hdl/particle/*.config
hdl/particle/*.bit
hdl/particle/*.bin

# Python Bytecode Cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# The contents of the build directories should be ignored, but not the directory itself
build/*
!build/.gitkeep
apps/act/build/*
!apps/act/build/.gitkeep
apps/asm/build/*
!apps/asm/build/.gitkeep

# Parcore generated synthesis artifacts
hdl/parcore/parcore_top.sv
hdl/parcore/*.synth.json
hdl/parcore/*.config
hdl/parcore/*.bit

# Stage kernel binary builds
build/parcore/
