// test_short_circuit_value: && and || used as values, with right operands
// long enough that a 4-bit branch could not skip them, and with side
// effects that must not run when the result is already decided.
// Passes with trap(0); fails with trap(15).

u32 g_calls = 0;

u32 bump(u32 v) {
    g_calls += 1;
    return v;
}

void main() {
    u32 ok = 1;
    u32 a = 3;
    u32 b = 4;
    u32 c = 5;

    u32 t = a && (a * b + b * c - c * a + (a + b) * (b + c) == 80);
    if (t != 1) ok = 0;
    u32 f = 0 && (a * b + b * c - c * a + (a + b) * (b + c) == 80);
    if (f != 0) ok = 0;

    u32 o = 0 || (a * b + b * c - c * a + (a + b) * (b + c) == 80);
    if (o != 1) ok = 0;
    u32 o2 = a || (a * b + b * c - c * a + (a + b) * (b + c) == 0);
    if (o2 != 1) ok = 0;
    u32 o3 = 0 || (a * b + b * c - c * a + (a + b) * (b + c) == 0);
    if (o3 != 0) ok = 0;

    // Side effects only when evaluated
    g_calls = 0;
    u32 s1 = 0 && bump(1);
    u32 s2 = 1 || bump(1);
    if (g_calls != 0) ok = 0;
    u32 s3 = 1 && bump(7);
    u32 s4 = 0 || bump(0);
    if (g_calls != 2) ok = 0;
    if (s1 != 0 || s2 != 1 || s3 != 1 || s4 != 0) ok = 0;

    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
