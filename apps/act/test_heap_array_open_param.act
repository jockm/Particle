// test_heap_array_open_param: a heap array passed to an open-array parameter keeps its data and length
// Passes with trap(0); fails with trap(15).

u32 sum(u32 d[]) {
    u32 t = 0;
    for (u32 i : 0..d.len) {
        t += d[i];
    }
    return t;
}

u32 length(u32 d[]) {
    return d.len;
}

void main() {
    u32 ok = 1;
    u32 buf[] = u32.createArray(3);
    buf[0] = 1;
    buf[1] = 2;
    buf[2] = 3;
    if (length(buf) != 3) ok = 0;
    if (sum(buf) != 6) ok = 0;
    buf.destroyArray();
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
