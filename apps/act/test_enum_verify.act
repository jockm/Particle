enum Status {
    OK = 0,
    BUSY,
    TIMEOUT = 10,
    ERROR
};

type Window {
    u16 x;
    u16 y;
    u16 width;
    u16 height;
};

// Compile-time layout and enum constant verifications
verify(sizeof(u8) == 1, "u8 size mismatch");
verify(sizeof(u16) == 2, "u16 size mismatch");
verify(sizeof(u32) == 4, "u32 size mismatch");
verify(sizeof(Window) == 8, "Window struct size mismatch");
verify(OK == 0, "Enum OK mismatch");
verify(BUSY == 1, "Enum BUSY mismatch");
verify(TIMEOUT == 10, "Enum TIMEOUT mismatch");
verify(ERROR == 11, "Enum ERROR mismatch");

void main() {
    u32 cur_status = TIMEOUT;
    if (cur_status == 10) {
        // Success quit trap 0
        asm("TRAP 0");
    }
    // Failure quit trap 15
    asm("TRAP 15");
}
