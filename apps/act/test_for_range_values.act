// test_for_range_values: range for loops: exclusive upper bound, empty and reversed ranges
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 sum = 0;
    for (u32 i : 0..10) {
        sum += i;
    }
    if (sum != 45) ok = 0;
    u32 count = 0;
    for (u32 j : 3..7) {
        count += 1;
    }
    if (count != 4) ok = 0;
    u32 empty = 0;
    for (u32 k : 5..5) {
        empty += 1;
    }
    if (empty != 0) ok = 0;
    u32 rev = 0;
    for (u32 m : 7..3) {
        rev += 1;
    }
    if (rev != 0) ok = 0;
    u32 lo = 2;
    u32 hi = 6;
    u32 vc = 0;
    for (u32 v : lo..hi) {
        vc += v;
    }
    if (vc != 14) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
