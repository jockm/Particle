void test_accum() {
    u32 sum = 0;
    for (u32 i : 0..10) {
        sum += i;
    }
    // 0 + 1 + ... + 9 = 45
    if (sum != 45) {
        trap(15);
    }
}

void test_array_len() {
    u32 arr[8];
    for (u32 idx : 0..arr.len) {
        arr[idx] = idx * 3;
    }

    u32 check_sum = 0;
    for (u32 j : 0..arr.len) {
        check_sum += arr[j];
    }
    // (0 + 3 + 6 + 9 + 12 + 15 + 18 + 21) = 84
    if (check_sum != 84) {
        trap(15);
    }
}

void test_nested() {
    u32 counter = 0;
    for (u32 x : 0..5) {
        for (u32 y : 0..4) {
            counter += 1;
        }
    }
    // 5 * 4 = 20
    if (counter != 20) {
        trap(15);
    }
}

void test_break() {
    u32 reached = 0;
    for (u32 i : 0..100) {
        if (i == 7) {
            break;
        }
        reached += 1;
    }
    if (reached != 7) {
        trap(15);
    }
}

void main() {
    test_accum();
    test_array_len();
    test_nested();
    test_break();
    trap(0);
}
