// test_tuple_returns: returning 2, 3 and 4 values, with declarations, existing variables and _
// Passes with trap(0); fails with trap(15).

(u32, u32) divmod(u32 a, u32 b) {
    return (a / b, a % b);
}

(u32, u32, u32) three() {
    return (7, 8, 9);
}

(u32, u32, u32, u32) four(u32 base) {
    u32 b1 = base + 1;
    u32 b2 = base + 2;
    u32 b3 = base + 3;
    return (base, b1, b2, b3);
}

(u32, u32) swap(u32 a, u32 b) {
    return (b, a);
}

void main() {
    u32 ok = 1;
    (u32 q, u32 r) = divmod(17, 5);
    if (q != 3) ok = 0;
    if (r != 2) ok = 0;
    (q, r) = divmod(9, 4);
    if (q != 2) ok = 0;
    if (r != 1) ok = 0;
    (u32 only_q, _) = divmod(20, 6);
    if (only_q != 3) ok = 0;
    (_, u32 only_r) = divmod(20, 6);
    if (only_r != 2) ok = 0;
    (u32 a, u32 b, u32 c) = three();
    if (a != 7) ok = 0;
    if (b != 8) ok = 0;
    if (c != 9) ok = 0;
    (u32 w, u32 x, u32 y, u32 z) = four(10);
    if (w != 10) ok = 0;
    if (x != 11) ok = 0;
    if (y != 12) ok = 0;
    if (z != 13) ok = 0;
    (u32 s1, u32 s2) = swap(1, 2);
    if (s1 != 2) ok = 0;
    if (s2 != 1) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
