// test_arith_wraparound: 32-bit unsigned overflow and underflow wrap around
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 m = 0xFFFFFFFF;
    u32 w = m + 1;
    if (w != 0) ok = 0;
    u32 z = 0;
    u32 u = z - 1;
    if (u != 0xFFFFFFFF) ok = 0;
    u32 h = 0x10000;
    u32 sq = h * h;
    if (sq != 0) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
