#include "lib/protokernel.h"

// 1. Unified 'type' keyword for struct definition
type Color {
    u8 r;
    u8 g;
    u8 b;
};

// 2. Fixed-address @ memory binding
u32 mmio_reg[4] @ 0x00008000;

void main() {
    type Color c;
    c.r = 10;
    c.g = 20;
    c.b = 30;

    // 3. Array indexing on bound memory
    mmio_reg[0] = 0xAA;
    mmio_reg[1] = 0xBB;
    mmio_reg[2] = 0xCC;
    mmio_reg[3] = 0xDD;

    u32 sum = mmio_reg[0] + mmio_reg[1] + mmio_reg[2] + mmio_reg[3];

    // 0xAA (170) + 0xBB (187) + 0xCC (204) + 0xDD (221) = 782 (0x030E)
    if (sum == 782 && c.r == 10 && c.g == 20 && c.b == 30) {
        trap(14);
    } else {
        trap(15);
    }
}
