// test_bitwise_ops: bitwise AND, OR, XOR and NOT
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 a = 0xF0;
    u32 b = 0x3C;
    u32 r = a & b;
    if (r != 0x30) ok = 0;
    r = a | b;
    if (r != 0xFC) ok = 0;
    r = a ^ b;
    if (r != 0xCC) ok = 0;
    u32 z = 0;
    r = ~z;
    if (r != 0xFFFFFFFF) ok = 0;
    u32 hi = 0xFFFF0000;
    r = ~hi;
    if (r != 0x0000FFFF) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
