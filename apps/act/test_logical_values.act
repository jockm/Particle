// test_logical_values: &&, || and ! produce 0 or 1 for any non-zero operands
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 one = 1;
    u32 two = 2;
    u32 zero = 0;
    u32 v = one && two;
    if (v != 1) ok = 0;
    v = two && zero;
    if (v != 0) ok = 0;
    v = zero || two;
    if (v != 1) ok = 0;
    v = zero || zero;
    if (v != 0) ok = 0;
    v = !two;
    if (v != 0) ok = 0;
    if (two && one) {
    } else {
        ok = 0;
    }
    if (zero || zero) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
