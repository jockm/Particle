// test_main_args: main takes the command line; on Particle it is empty
// Passes with trap(0); fails with trap(15).

u32 main(ref string args[]) {
    u32 ok = 1;
    // On Particle there is no command line; on a computer args[0] is the
    // program's name
    if (args.len > 0) {
        if (args[0].len == 0) ok = 0;
        string first[64] = args[0];
        if (first.len == 0) ok = 0;
    }
    if (ok == 1) {
        trap(0);
    }
    trap(15);
    return 1;
}
