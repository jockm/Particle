void main() {
    u32 arr = u32.createArray(5);
    
    // In-bounds writes: valid
    arr[0] = 1;
    arr[4] = 5;

    // Out-of-bounds write: index 5 >= length 5 -> MUST trigger TRAP 15
    arr[5] = 99;

    // If bounds check failed to fire, this TRAP 14 will execute (test failure)
    trap(14);
}
