type Core {
    u32 freq;
};

void Core.boost(u32 amount) {
    this.freq = this.freq + amount;
}

u32 Core.get_freq() {
    return this.freq;
}

type ComputeTile {
    Core;
    u32 tile_id;
};

u32 ComputeTile.tile_score() {
    return this.freq + this.tile_id;
}

type Node {
    ComputeTile;
    u32 ram_mb;
};

u32 Node.total_metric() {
    return this.freq + this.tile_id + this.ram_mb;
}

void main() {
    Node n;
    n.freq = 1000;
    n.tile_id = 7;
    n.ram_mb = 4096;

    // 2-level promoted method with receiver mutation:
    n.boost(500);

    // 2-level promoted getter:
    u32 f = n.get_freq();

    // 1-level promoted method:
    u32 ts = n.tile_score();

    // Direct method:
    u32 tm = n.total_metric();

    trap(14);
}
