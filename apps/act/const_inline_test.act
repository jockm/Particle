// Global constants
const u32 BASE_VAL = 100;
const u32 MULTIPLIER = 4;
const u32 COMPUTED = (BASE_VAL * MULTIPLIER) + (1 << 3); // 400 + 8 = 408

// Inline utility functions
inline u32 square(u32 n) {
    return n * n;
}

inline u32 clamp(u32 val, u32 min_v, u32 max_v) {
    if (val < min_v) {
        return min_v;
    }
    if (val > max_v) {
        return max_v;
    }
    return val;
}

void main() {
    // Local constants
    const u32 LOCAL_OFFSET = 12;
    const u32 TOTAL_EXPECTED = COMPUTED + LOCAL_OFFSET; // 408 + 12 = 420

    // Test constant evaluations
    if (COMPUTED != 408) {
        trap(15);
    }
    if (TOTAL_EXPECTED != 420) {
        trap(15);
    }

    // Test inline function expansion
    u32 sq = square(9); // 81
    if (sq != 81) {
        trap(15);
    }

    // Test inline function with conditional branches / early returns
    u32 c1 = clamp(5, 10, 50);   // Should clamp to 10
    u32 c2 = clamp(100, 10, 50);  // Should clamp to 50
    u32 c3 = clamp(25, 10, 50);   // Should return 25

    if (c1 != 10) {
        trap(15);
    }
    if (c2 != 50) {
        trap(15);
    }
    if (c3 != 25) {
        trap(15);
    }

    // All verifications passed
    trap(14);
}
