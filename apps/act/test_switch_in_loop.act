// test_switch_in_loop: break inside a switch leaves the switch, not the enclosing loop
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 ones = 0;
    u32 others = 0;
    u32 iterations = 0;
    for (u32 i : 0..6) {
        iterations += 1;
        u32 m = i % 2;
        switch (m) {
            case 1:
                ones += 1;
                break;
            default:
                others += 1;
                break;
        }
    }
    if (iterations != 6) ok = 0;
    if (ones != 3) ok = 0;
    if (others != 3) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
