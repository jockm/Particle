// test_mod_assign: '%=' on variables, array elements and fields, unsigned
// and signed (the remainder takes the sign of the dividend).
// Passes with trap(0); fails with trap(15).

type Box {
    u32 v;
    s32 s;
};

void main() {
    u32 ok = 1;

    u32 a = 17;
    a %= 5;
    if (a != 2) ok = 0;

    s32 b = -7;
    b %= 2;
    if (b != -1) ok = 0;

    u32 arr[3];
    arr[1] = 23;
    arr[1] %= 10;
    if (arr[1] != 3) ok = 0;

    Box bx;
    bx.v = 100;
    bx.v %= 7;
    bx.s = -100;
    bx.s %= 7;
    if (bx.v != 2 || bx.s != -2) ok = 0;

    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
