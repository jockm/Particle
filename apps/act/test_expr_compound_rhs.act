// test_expr_compound_rhs: compound assignment with a computed right side
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 x = 10;
    u32 a = 2;
    u32 b = 3;
    x += a * b;
    if (x != 16) ok = 0;
    x -= a + b;
    if (x != 11) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
