// test_trap_handlers: trap(N) handlers run when trap N is
// taken, and the interrupted code continues with its values intact.
// Passes with trap(0); fails with trap(15).

const u32 TICK = 2;

u32 g_ticks = 0;
u32 g_last = 0;
u32 g_faults = 0;

u32 square(u32 v) {
    return v * v;
}

// A handler may use locals and call other functions
trap(TICK) on_tick() {
    u32 local = square(3);
    g_ticks += 1;
    g_last = local;
}

trap(13) on_user() {
    g_last = 13;
}

trap(14) on_misaligned() {
    g_faults += 1;
}

void main() {
    u32 ok = 1;
    u32 a = 11;
    u32 b = 22;

    trap(2);
    if (g_ticks != 1 || g_last != 9) ok = 0;

    // Values held in registers and locals survive the trap
    u32 c = a + b;
    trap(TICK);
    if (c != 33 || a + b != 33) ok = 0;
    if (g_ticks != 2) ok = 0;

    trap(13);
    if (g_last != 13) ok = 0;

    // An explicit TRAP 14 goes to its handler like any other trap
    trap(14);
    if (g_faults != 1) ok = 0;

    // A trap with no handler returns straight away
    trap(5);

    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
