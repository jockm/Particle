// test_stack_args: call slots past R4 are passed on the stack. Covers
// plain calls, mixed types, an open array split across slots 4 and 5,
// methods, function references, recursion and nested calls as arguments.
// Passes with trap(0); fails with trap(15).

type Acc {
    u32 total;
};

type Six = fn(u32, u32, u32, u32, u32, u32) -> u32;

u32 weigh6(u32 a, u32 b, u32 c, u32 d, u32 e, u32 f) {
    return a + b * 2 + c * 3 + d * 4 + e * 5 + f * 6;
}

s32 mixed(u8 a, s16 b, u32 c, s32 d, s8 e, u16 f, u32 g) {
    return a + b + c + d + e + f + g;
}

// Open array takes slots 4 (pointer) and 5 (length)
u32 tail_sum(u32 a, u32 b, u32 c, u32 xs[], u32 k) {
    u32 s = a + b + c + k;
    for (u32 i : 0..xs.len) {
        s += xs[i];
    }
    return s + xs.len * 1000;
}

u32 Acc.add5(u32 a, u32 b, u32 c, u32 d, u32 e) {
    this.total += a + b + c + d + e;
    return this.total;
}

// Locals and stack arguments together, through recursion
u32 countdown(u32 n, u32 a, u32 b, u32 c, u32 d, u32 e) {
    u32 local = e;
    if (n == 0) {
        return a + b + c + d + local;
    }
    return countdown(n - 1, a + 1, b, c, d, local + 1);
}

void main() {
    u32 ok = 1;

    if (weigh6(1, 2, 3, 4, 5, 6) != 91) ok = 0;

    // Arguments that are themselves calls and expressions
    u32 x = 3;
    if (weigh6(x + 1, weigh6(1, 1, 1, 1, 1, 1), 0, 0, x * 2, 1) != 4 + 42 + 30 + 6) ok = 0;

    if (mixed(1, -2, 3, -4, -5, 6, 7) != 6) ok = 0;

    u32 arr[3];
    arr[0] = 10;
    arr[1] = 20;
    arr[2] = 30;
    if (tail_sum(1, 2, 3, arr, 4) != 3070) ok = 0;

    Acc acc;
    acc.total = 0;
    acc.add5(1, 2, 3, 4, 5);
    if (acc.add5(10, 20, 30, 40, 50) != 165) ok = 0;

    Six f = weigh6;
    if (f(6, 5, 4, 3, 2, 1) != 56) ok = 0;

    if (countdown(3, 0, 10, 20, 30, 40) != 3 + 10 + 20 + 30 + 43) ok = 0;

    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
