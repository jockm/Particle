// test_slices: slices passed to open array parameters
// Passes with trap(0); fails with trap(15).

u32 sum(u32 d[]) {
    u32 t = 0;
    for (u32 i : 0..d.len) {
        t += d[i];
    }
    return t;
}

u32 length(u32 d[]) {
    return d.len;
}

u32 first(u32 d[]) {
    return d[0];
}

void main() {
    u32 ok = 1;
    u32 a[6];
    for (u32 i : 0..6) {
        a[i] = i;
    }
    // a = 0 1 2 3 4 5
    if (sum(a[1..3]) != 3) ok = 0;
    if (length(a[1..3]) != 2) ok = 0;
    if (sum(a[..2]) != 1) ok = 0;
    if (sum(a[4..]) != 9) ok = 0;
    if (length(a[4..]) != 2) ok = 0;
    if (first(a[3..]) != 3) ok = 0;
    u32 s = 2;
    u32 e = 5;
    if (sum(a[s..e]) != 9) ok = 0;
    if (length(a[s..e]) != 3) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
