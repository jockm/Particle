// test_switch_basic: switch selects the matching case
// Passes with trap(0); fails with trap(15).

u32 pick(u32 v) {
    u32 r = 0;
    switch (v) {
        case 1:
            r = 10;
            break;
        case 2:
            r = 20;
            break;
        case 3:
            r = 30;
            break;
    }
    return r;
}

void main() {
    u32 ok = 1;
    if (pick(1) != 10) ok = 0;
    if (pick(2) != 20) ok = 0;
    if (pick(3) != 30) ok = 0;
    if (pick(4) != 0) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
