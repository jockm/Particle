// test_inline_asm: inline assembly is emitted verbatim; a function can return a value set in R1
// Passes with trap(0); fails with trap(15).
// Target: particle (inline assembly)

u32 seven() {
    asm("LD      R1, 7");
}

void main() {
    u32 ok = 1;
    if (seven() != 7) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
