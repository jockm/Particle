// test_reference_flow: references checked along every path compile and behave as written
// Passes with trap(0); fails with trap(15).

type Item {
    u32 id;
};

// Some returns give 0, so the result may be null
Item find(u32 id) {
    if (id == 0) {
        return 0;
    }
    Item it = Item.create();
    it.id = id;
    return it;
}

// Every return gives a valid reference, so the result can be used directly
Item make(u32 depth) {
    if (depth == 0) {
        return Item.create();
    }
    return make(depth - 1);
}

void main() {
    u32 ok = 1;

    Item a = find(7);
    if (a.exists()) {
        if (a.id != 7) ok = 0;
        a.destroy();
    } else {
        ok = 0;
    }

    Item none = find(0);
    if (!none.exists()) {
        none = Item.create();
        none.id = 3;
    }
    if (none.id != 3) ok = 0;

    Item b = make(2);
    b.id = 9;

    // A move on one branch only: the other branch still owns 'b'
    Item kept = 0;
    if (ok == 1) {
        kept = b;
    } else {
        b.destroy();
    }
    if (kept.exists() && kept.id != 9) ok = 0;

    u32 buf[] = u32.createArray(3);
    u32 i = 0;
    while (i < 3) {
        buf[i] = i + 1;
        i += 1;
    }
    if (buf[2] != 3) ok = 0;
    buf.destroyArray();
    if (buf.exists()) ok = 0;

    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
