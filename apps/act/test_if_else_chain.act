// test_if_else_chain: if / else if / else chains
// Passes with trap(0); fails with trap(15).

u32 classify(u32 n) {
    if (n == 0) {
        return 0;
    } else if (n < 10) {
        return 1;
    } else if (n < 100) {
        return 2;
    } else {
        return 3;
    }
}

void main() {
    u32 ok = 1;
    if (classify(0) != 0) ok = 0;
    if (classify(5) != 1) ok = 0;
    if (classify(42) != 2) ok = 0;
    if (classify(500) != 3) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
