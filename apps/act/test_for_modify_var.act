// test_for_modify_var: the loop body may change the loop variable
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 count = 0;
    for (u32 i : 0..10) {
        count += 1;
        i += 1;
    }
    if (count != 5) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
