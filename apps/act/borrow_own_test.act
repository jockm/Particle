type Item {
    u32 id;
    u32 value;
};

void mutate_item(Item it) {
    it.value = it.value + 10;
}

u32 main() {
    Item it = Item.create();
    it.id = 1;
    it.value = 50;

    mutate_item(it);

    if (it.value != 60) {
        trap(15);
    }

    // Caller retains ownership across the call and destroys it
    it.destroy();

    if (it.exists() != 0) {
        trap(15);
    }

    // Signal test pass
    trap(14);
    return 0;
}
