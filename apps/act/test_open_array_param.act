// test_open_array_param: open array parameters receive the length; changes are visible to the caller
// Passes with trap(0); fails with trap(15).

u32 sum(u32 d[]) {
    u32 t = 0;
    for (u32 i : 0..d.len) {
        t += d[i];
    }
    return t;
}

u32 length(u32 d[]) {
    return d.len;
}

u32 forward(u32 d[]) {
    return sum(d);
}

void fill(u32 d[], u32 v) {
    for (u32 i : 0..d.len) {
        d[i] = v;
    }
}

void main() {
    u32 ok = 1;
    u32 a[5];
    for (u32 i : 0..5) {
        a[i] = i + 1;
    }
    if (sum(a) != 15) ok = 0;
    if (length(a) != 5) ok = 0;
    if (forward(a) != 15) ok = 0;
    u32 b[3];
    fill(b, 7);
    if (b[0] != 7) ok = 0;
    if (b[2] != 7) ok = 0;
    if (sum(b) != 21) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
