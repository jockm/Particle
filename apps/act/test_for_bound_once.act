// test_for_bound_once: the upper bound of a range for loop is evaluated once
// Passes with trap(0); fails with trap(15).

u32 calls = 0;

u32 limit() {
    calls += 1;
    return 5;
}

void main() {
    u32 ok = 1;
    u32 n = 0;
    for (u32 i : 0..limit()) {
        n += 1;
    }
    if (n != 5) ok = 0;
    if (calls != 1) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
