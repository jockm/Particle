// test_array_results: functions that return heap arrays and heap strings,
// alone or in a tuple
// Passes with trap(0); fails with trap(15).

type Node {
    u32 v;
};

u32[] range(u32 n) {
    u32 xs[] = u32.createArray(n);
    for (u32 i : 0..n) {
        xs[i] = i * i;
    }
    return xs;
}

string[] repeat(u8 ch, u32 n) {
    string s[] = string.create(n + 1);
    for (u32 i : 0..n) {
        s[i] = ch;
    }
    return s;
}

ref Node[] nodes(u32 n) {
    ref Node ns[] = Node.createArray(n);
    ns[n - 1] = Node.create(v: 7);
    return ns;
}

(u16[], u32) halves(u32 n) {
    u16 hs[] = u16.createArray(n);
    hs[0] = 5;
    return (hs, n / 2);
}

u32 sum(u32 xs[]) {
    u32 t = 0;
    for (u32 i : 0..xs.len) {
        t += xs[i];
    }
    return t;
}

void main() {
    u32 ok = 1;

    u32 sq[] = range(4);
    if (sq.len != 4 || sq[3] != 9 || sum(sq) != 14) ok = 0;
    sq.destroyArray();

    string s[] = repeat('z', 3);
    if (s.len != 3 || s[2] != 'z' || s.capacity != 4) ok = 0;
    s.destroy();

    ref Node ns[] = nodes(2);
    if (ns.len != 2 || ns[0].exists() || ns[1].v != 7) ok = 0;
    ns[1].destroy();
    ns.destroyArray();

    (u16 hs[], u32 half) = halves(6);
    if (hs.len != 6 || hs[0] != 5 || half != 3) ok = 0;
    hs.destroyArray();

    if (ok == 1) {
        trap(0);
    }
    trap(15);
}
