// test_coroutine_yield: yield returns status 1 and resumes after the yield on the next call
// Passes with trap(0); fails with trap(15).

import "lib/protokernel.act";

type Task {
    u16 lc;
    u32 count;
};

u32 ticker(Task t) {
    while (1) {
        t.count += 1;
        yield(t, 1);
    }
}

void main() {
    u32 ok = 1;
    Task t;
    u32 s = ticker(t);
    if (s != 1) ok = 0;
    if (t.count != 1) ok = 0;
    s = ticker(t);
    if (s != 1) ok = 0;
    s = ticker(t);
    if (t.count != 3) ok = 0;
    if (t.lc != 1) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
