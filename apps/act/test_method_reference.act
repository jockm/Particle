// test_method_reference: Type.method yields a function value that takes the receiver first
// Passes with trap(0); fails with trap(15).

type Acc {
    u32 total;
};

type AddFn = fn(Acc, u32) -> u32;

u32 Acc.add(u32 n) {
    this.total += n;
    return this.total;
}

void main() {
    u32 ok = 1;
    Acc a;
    a.total = 1;
    AddFn f = Acc.add;
    u32 r = f(a, 4);
    if (r != 5) ok = 0;
    if (a.total != 5) ok = 0;
    r = f(a, 10);
    if (a.total != 15) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
