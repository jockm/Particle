// The helpers below take their arguments in R1..R3 (the calling
// convention); spilling the parameters leaves those registers intact, so
// the asm uses them directly. The result is returned in R1.
// Target: particle (inline assembly)

// Raw allocator payload of a heap array: the address of its 4-byte length
// header, just below the elements.
u32 raw_of(u32 arr[]) {
    asm("SUB     R1, 4");            // arr arrives in R1 (its length in R2)
}

u32 realloc_raw(u32 raw_ptr, u32 new_size) {
    // raw_ptr in R1, new_size in R2, as _rt_realloc expects
    asm("RCALL   _rt_realloc");      // Returns result in R1
}

void set_elem(u32 raw_ptr, u32 word_offset, u32 val) {
    // raw_ptr in R1, word_offset (in bytes) in R2, val in R3
    asm("ADD     R1, R2");
    asm("LD32    (R1), R3");         // Store val at raw_ptr + word_offset
}

u32 get_elem(u32 raw_ptr, u32 word_offset) {
    // raw_ptr in R1, word_offset (in bytes) in R2
    asm("ADD     R1, R2");
    asm("LD32    R1, (R1)");         // Load into R1 (return value)
}

void main() {
    // 1. Allocate initial array of 4 u32s
    u32 arr1[] = u32.createArray(4);
    arr1[0] = 10;
    arr1[1] = 20;
    arr1[2] = 30;
    arr1[3] = 40;

    // Raw chunk payload: 4-byte length prefix + 4 * 4 data bytes = 20 bytes
    u32 raw1 = raw_of(arr1);

    // 2. Grow to 36 bytes (8 words data + 4 bytes header)
    u32 raw2 = realloc_raw(raw1, 36);
    // Update array length header to 8
    set_elem(raw2, 0, 8);

    // Verify initial 4 elements preserved
    if (get_elem(raw2, 4) != 10 || get_elem(raw2, 8) != 20 ||
        get_elem(raw2, 12) != 30 || get_elem(raw2, 16) != 40) {
        trap(15);
    }

    // Populate slot 4 (byte offset 20) and slot 7 (byte offset 32)
    set_elem(raw2, 20, 50);
    set_elem(raw2, 32, 80);

    if (get_elem(raw2, 20) + get_elem(raw2, 32) != 130) {
        trap(15);
    }

    // 3. Shrink to 12 bytes (2 words data + 4 bytes header)
    u32 raw3 = realloc_raw(raw2, 12);
    set_elem(raw3, 0, 2);

    if (get_elem(raw3, 4) != 10 || get_elem(raw3, 8) != 20) {
        trap(15);
    }

    // 4. Free via realloc(raw3, 0)
    realloc_raw(raw3, 0);

    trap(0);
}
