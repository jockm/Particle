// test_heap_ownership_move: assigning a heap reference moves it; the new owner sees the same data
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 a[] = u32.createArray(4);
    a[0] = 123;
    a[3] = 456;
    u32 b[];
    if (b.exists() != 0) ok = 0;
    b = a;
    if (b.exists() != 1) ok = 0;
    if (b.len != 4) ok = 0;
    if (b[0] != 123) ok = 0;
    if (b[3] != 456) ok = 0;
    b.destroyArray();
    if (b.exists() != 0) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
