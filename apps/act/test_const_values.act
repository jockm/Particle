// test_const_values: const values, including constant expressions built from other consts
// Passes with trap(0); fails with trap(15).

const u32 BASE = 10;
const u32 TRIPLE = BASE * 3;
const u32 MASK = 0xFF00 | 0x00F0;
const u32 SHIFTED = 1 << 5;

void main() {
    u32 ok = 1;
    const u32 LOCAL = TRIPLE + 2;
    u32 v = BASE;
    if (v != 10) ok = 0;
    v = TRIPLE;
    if (v != 30) ok = 0;
    v = MASK;
    if (v != 0xFFF0) ok = 0;
    v = SHIFTED;
    if (v != 32) ok = 0;
    v = LOCAL;
    if (v != 32) ok = 0;
    u32 w = 5;
    u32 r = w + BASE;
    if (r != 15) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
