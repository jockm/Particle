// test_if_no_braces: if/else without braces; else binds to the nearest if
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 a = 1;
    u32 b = 0;
    u32 x = 0;
    if (a == 1)
        if (b == 1)
            x = 1;
        else
            x = 2;
    if (x != 2) ok = 0;
    u32 y = 0;
    if (a == 0) y = 5; else y = 6;
    if (y != 6) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
