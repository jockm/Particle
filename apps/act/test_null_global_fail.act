// test_null_global_fail: using an empty reference held in a global stops at the run-time reference check
// Must stop at: Null reference trap
// Passes when the simulator stops with trap 15 at that check; trap(0) at the end means the check is missing.

type Item {
    u32 id;
};

ref Item current;

void main() {
    current.id = 5;
    trap(0);
}
