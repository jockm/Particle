// test_shifts: left and right shifts by constant and variable amounts
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 one = 1;
    u32 r = one << 4;
    if (r != 16) ok = 0;
    u32 v = 0x80;
    r = v >> 3;
    if (r != 0x10) ok = 0;
    u32 n = 31;
    r = one << n;
    if (r != 0x80000000) ok = 0;
    u32 k = 8;
    u32 w = 0x1234;
    r = w >> k;
    if (r != 0x12) ok = 0;
    r = w << k;
    if (r != 0x123400) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
