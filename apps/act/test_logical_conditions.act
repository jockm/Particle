// test_logical_conditions: nested && and || inside if and while conditions
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 a = 1;
    u32 b = 2;
    u32 c = 3;
    if (a < b && b < c) {
    } else {
        ok = 0;
    }
    if (a > b || c == 3) {
    } else {
        ok = 0;
    }
    if (a > b && c == 3) ok = 0;
    if (a == 9 || b == 9 || c == 9) ok = 0;
    if ((a == 1 || b == 9) && (c == 3 || a == 9)) {
    } else {
        ok = 0;
    }
    if (a == 1 && b == 9 || c == 3) {
    } else {
        ok = 0;
    }
    u32 n = 0;
    while (n < 10 && n != 4) {
        n += 1;
    }
    if (n != 4) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
