// test_fixed_bounds_fail: an out-of-bounds index on a fixed array must stop
// at its bounds check with TRAP 15. Listed in ACT_TRAP_TESTS in the
// Makefile, which requires exit 15 from that check.

void main() {
    u32 arr[5];
    u32 i = 4;

    // In-bounds write: valid
    arr[i] = 1;

    // Out-of-bounds write: index 5 >= length 5 -> MUST trigger TRAP 15
    i = 5;
    arr[i] = 99;

    // If bounds check failed to fire, this TRAP 0 will execute (test failure)
    trap(0);
}
