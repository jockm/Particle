// test_while_break: break leaves a while loop
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 n = 0;
    while (1) {
        n += 1;
        if (n == 7) break;
    }
    if (n != 7) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
