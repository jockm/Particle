// test_functions_basic: calling functions with up to four parameters and return values
// Passes with trap(0); fails with trap(15).

u32 add(u32 a, u32 b) {
    return a + b;
}

u32 digits(u32 a, u32 b, u32 c, u32 d) {
    u32 r = a * 1000;
    u32 t = b * 100;
    r = r + t;
    t = c * 10;
    r = r + t;
    r = r + d;
    return r;
}

u32 counter = 0;

void tick() {
    counter += 1;
}

void main() {
    u32 ok = 1;
    if (add(2, 3) != 5) ok = 0;
    u32 x = 4;
    u32 y = 9;
    if (add(x, y) != 13) ok = 0;
    if (digits(1, 2, 3, 4) != 1234) ok = 0;
    tick();
    tick();
    if (counter != 2) ok = 0;
    u32 n = add(x, y);
    n = add(n, 1);
    if (n != 14) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
