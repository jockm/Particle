// test_compare_signed: signed comparisons when an operand has a signed type
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    s32 a = -5;
    s32 b = 3;
    if (!(a < b)) ok = 0;
    if (!(b > a)) ok = 0;
    if (!(a <= b)) ok = 0;
    if (a >= b) ok = 0;
    s32 zero = 0;
    if (!(a < zero)) ok = 0;
    s8 c = -1;
    s8 d = 1;
    if (!(c < d)) ok = 0;
    s16 e = -300;
    s16 f = 200;
    if (!(e < f)) ok = 0;
    s32 m = -1;
    if (m != -1) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
