// test_sizeof: sizeof on types, records, variables, arrays and expressions, at run time too
// Passes with trap(0); fails with trap(15).

type Window {
    u32 id;
    u16 w;
    u16 h;
    u8 flags;
};

void main() {
    u32 ok = 1;
    u32 s = sizeof(u8);
    if (s != 1) ok = 0;
    s = sizeof(s16);
    if (s != 2) ok = 0;
    s = sizeof(u32);
    if (s != 4) ok = 0;
    s = sizeof(u64);
    if (s != 8) ok = 0;
    s = sizeof(Window);
    if (s != 12) ok = 0;    // 9 bytes of fields, padded to 4-byte alignment
    u8 c;
    s = sizeof(c);
    if (s != 1) ok = 0;
    u16 h;
    s = sizeof(h);
    if (s != 2) ok = 0;
    u32 arr[5];
    s = sizeof(arr);
    if (s != 20) ok = 0;
    u16 grid[2][3];
    s = sizeof(grid);
    if (s != 12) ok = 0;
    string name[16] = "x";
    s = sizeof(name);
    if (s != 16) ok = 0;
    Window win;
    s = sizeof(win.w);
    if (s != 2) ok = 0;
    s = sizeof(win.flags);
    if (s != 1) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
