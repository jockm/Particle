// test_fixed_arrays: fixed arrays of u32, u16 and u8 with .len and .capacity
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 a[8];
    for (u32 i : 0..8) {
        a[i] = i * 3;
    }
    if (a[0] != 0) ok = 0;
    if (a[7] != 21) ok = 0;
    if (a.len != 8) ok = 0;
    if (a.capacity != 8) ok = 0;
    u16 h[5];
    for (u32 j : 0..5) {
        h[j] = 0x1000 + j;
    }
    if (h[4] != 0x1004) ok = 0;
    if (h[1] != 0x1001) ok = 0;
    u8 b[10];
    for (u32 k : 0..10) {
        b[k] = 200 + k;
    }
    if (b[9] != 209) ok = 0;
    if (b[0] != 200) ok = 0;
    u32 wide9 = 0x1FF;  // a constant that does not fit u8 is an error
    b[3] = wide9;
    if (b[3] != 0xFF) ok = 0;
    if (b[4] != 204) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
