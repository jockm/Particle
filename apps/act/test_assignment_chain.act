// test_assignment_chain: assignment is an expression and chains right to left
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 a = 0;
    u32 b = 0;
    u32 c = 0;
    a = b = c = 7;
    if (a != 7) ok = 0;
    if (b != 7) ok = 0;
    if (c != 7) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
