// test_memory_builtins: peek8/16/32 and poke8/16/32 at an address computed at run time
// Passes with trap(0); fails with trap(15).
//act:build particle
// Particle only: fixed addresses

const u32 SCRATCH = 0x9000;    // free RAM: above the program, below the stack (no heap is used)

u32 at(u32 i) {
    return SCRATCH + i * 4;
}

void main() {
    u32 ok = 1;
    for (u32 i : 0..4) {
        poke32(at(i), 0x11111111 * (i + 1));
    }
    if (peek32(at(0)) != 0x11111111) ok = 0;
    if (peek32(at(3)) != 0x44444444) ok = 0;
    u32 sum = 0;
    for (u32 i : 0..4) {
        sum += peek32(at(i));
    }
    if (sum != 0xAAAAAAAA) ok = 0;
    // poke16 writes only the low halfword (Particle is little-endian)
    poke32(SCRATCH, 0xFFFFFFFF);
    poke16(SCRATCH, 0x1234);
    if (peek32(SCRATCH) != 0xFFFF1234) ok = 0;
    poke16(SCRATCH + 2, 0xABCD);
    if (peek32(SCRATCH) != 0xABCD1234) ok = 0;

    // peek8, peek16 and poke8 read and write single bytes and halfwords
    if (peek16(SCRATCH) != 0x1234 || peek16(SCRATCH + 2) != 0xABCD) ok = 0;
    if (peek8(SCRATCH) != 0x34 || peek8(SCRATCH + 3) != 0xAB) ok = 0;
    poke8(SCRATCH + 1, 0x7F);
    if (peek32(SCRATCH) != 0xABCD7F34) ok = 0;
    poke8(SCRATCH + 3, 0x80);
    if (peek8(SCRATCH + 3) != 0x80) ok = 0;
    if (ok == 1) {
        trap(0);
    }
    trap(15);
}
