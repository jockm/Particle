type Point {
    u32 x;
    u32 y;
};

Point Point.move(u32 dx, u32 dy) {
    this.x = this.x + dx;
    this.y = this.y + dy;
    return this;
}

u32 Point.get_sum() {
    return this.x + this.y;
}

void main() {
    Point pt;
    pt.x = 10;
    pt.y = 20;

    // Test method chaining: move() returns Point, chaining another move()
    pt.move(5, 5).move(10, 15);

    // pt.x should now be 10 + 5 + 10 = 25
    // pt.y should now be 20 + 5 + 15 = 40
    // get_sum() should return 25 + 40 = 65
    u32 total = pt.get_sum();

    if (pt.x == 25 && pt.y == 40 && total == 65) {
        trap(14);
    } else {
        trap(15);
    }
}
