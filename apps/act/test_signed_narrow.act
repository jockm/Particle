// test_signed_narrow: s8 and s16 values are sign-extended on load
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    s8 c = -1;
    s32 v = c;
    if (v != -1) ok = 0;
    s8 d = 127;
    d = d + 1;
    s32 e = d;
    if (e != -128) ok = 0;
    s16 h = -300;
    s32 hv = h;
    if (hv != -300) ok = 0;
    s16 g = 32767;
    g = g + 1;
    s32 gv = g;
    if (gv != -32768) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
