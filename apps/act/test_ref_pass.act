import "lib/protokernel.act";

type Color {
    u8 r;
    u8 g;
    u8 b;
};

void mutate_color(type Color col, u8 nr, u8 ng, u8 nb) {
    col.r = nr;
    col.g = ng;
    col.b = nb;
}

void main() {
    type Color c;
    c.r = 1;
    c.g = 2;
    c.b = 3;

    // Implicit pass-by-reference: caller passes &c automatically
    mutate_color(c, 100, 150, 200);

    // Caller verifies the mutation
    if (c.r == 100 && c.g == 150 && c.b == 200) {
        trap(0);
    } else {
        trap(15);
    }
}
