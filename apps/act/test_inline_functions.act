// test_inline_functions: inline functions are expanded at the call site
// Passes with trap(0); fails with trap(15).

inline u32 twice(u32 v) {
    return v * 2;
}

inline u32 pick(u32 c, u32 a, u32 b) {
    if (c != 0) {
        return a;
    }
    return b;
}

void main() {
    u32 ok = 1;
    u32 x = 21;
    u32 y = twice(x);
    if (y != 42) ok = 0;
    if (twice(5) != 10) ok = 0;
    if (pick(1, 3, 4) != 3) ok = 0;
    if (pick(0, 3, 4) != 4) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
