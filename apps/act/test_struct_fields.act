// test_struct_fields: record fields of different sizes are stored and read independently
// Passes with trap(0); fails with trap(15).

type Mixed {
    u32 a;
    u16 b;
    u8 c;
    s8 d;
    s32 e;
};

void main() {
    u32 ok = 1;
    Mixed m;
    m.a = 0x11223344;
    m.b = 0x5566;
    m.c = 0x77;
    m.d = -2;
    m.e = -100000;
    if (m.a != 0x11223344) ok = 0;
    if (m.b != 0x5566) ok = 0;
    if (m.c != 0x77) ok = 0;
    if (m.d != -2) ok = 0;
    if (m.e != -100000) ok = 0;
    m.c = 0x1AB;
    if (m.c != 0xAB) ok = 0;
    if (m.b != 0x5566) ok = 0;
    if (m.d != -2) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
