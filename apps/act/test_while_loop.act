// test_while_loop: while loops, including one that never runs
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 i = 0;
    u32 sum = 0;
    while (i < 10) {
        sum += i;
        i += 1;
    }
    if (sum != 45) ok = 0;
    if (i != 10) ok = 0;
    u32 runs = 0;
    u32 zero = 0;
    while (zero != 0) {
        runs += 1;
    }
    if (runs != 0) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
