// test_bound_address: @-bound variables and arrays access fixed memory addresses (assumes RAM at 0x8000)
// Passes with trap(0); fails with trap(15).
//act:build particle
// Particle only: fixed addresses

u32 SCRATCH @ 0x00008000;
u8 BYTES[8] @ 0x00008010;
u16 HALF @ 0x00008020;

void main() {
    u32 ok = 1;
    SCRATCH = 0x12345678;
    if (SCRATCH != 0x12345678) ok = 0;
    for (u32 i : 0..8) {
        BYTES[i] = i + 1;
    }
    if (BYTES[0] != 1) ok = 0;
    if (BYTES[7] != 8) ok = 0;
    HALF = 0xABCD;
    if (HALF != 0xABCD) ok = 0;
    u32 local_bound @ 0x00008030;
    local_bound = 42;
    if (local_bound != 42) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
