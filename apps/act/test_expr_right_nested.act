// test_expr_right_nested: a binary operation as the right operand of another
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 a = 2;
    u32 b = 3;
    u32 c = 4;
    u32 r = a + b * c;
    if (r != 14) ok = 0;
    r = c - (b - a);
    if (r != 3) ok = 0;
    r = a * (b + c);
    if (r != 14) ok = 0;
    if (r != a + 12) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
