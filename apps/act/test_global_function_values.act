// test_global_function_values: globals, tables and records start with
// functions, on both targets.
// Passes with trap(0); fails with trap(15).

type Op = fn(u32) -> u32;
type Point { u32 x; }
u32 dbl(u32 x) { return x * 2; }
u32 inc(u32 x) { return x + 1; }
u32 Point.get() { return this.x; }
Op g = dbl;
Op none;
Op table[3] = { dbl, inc };
const Op ctable[2] = { inc, dbl };
type H { u32 n; Op f; u8 tag; Op g; }
H h = { n: 7, f: inc, tag: 3, g: dbl };
H hs[2] = { { n: 1, f: dbl }, { n: 2, g: inc } };
void main() {
    u32 ok = 1;
    if (g(4) != 8) ok = 0;
    if (table[0](5) != 10 || table[1](5) != 6) ok = 0;
    if (ctable[0](1) != 2 || ctable[1](3) != 6) ok = 0;
    if (h.n != 7 || h.f(1) != 2 || h.tag != 3 || h.g(2) != 4) ok = 0;
    if (hs[0].f(3) != 6 || hs[1].g(3) != 4 || hs[1].n != 2) ok = 0;
    g = inc;
    if (g(4) != 5) ok = 0;
    none = dbl;
    if (none(1) != 2) ok = 0;
    if (ok == 1) { trap(0); }
    trap(15);
}
