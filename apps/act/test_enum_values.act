// test_enum_values: enum auto-numbering, explicit values and expressions over earlier members
// Passes with trap(0); fails with trap(15).

enum Color { RED, GREEN, BLUE };
enum Code { C_OK = 0, BUSY, TIMEOUT = 10, FAILED, };
enum Derived { D_A = 3, D_B = D_A * 2, D_C, D_D = BLUE + 100 };

void main() {
    u32 ok = 1;
    u32 v = RED;
    if (v != 0) ok = 0;
    v = GREEN;
    if (v != 1) ok = 0;
    v = BLUE;
    if (v != 2) ok = 0;
    v = BUSY;
    if (v != 1) ok = 0;
    v = TIMEOUT;
    if (v != 10) ok = 0;
    v = FAILED;
    if (v != 11) ok = 0;
    v = D_B;
    if (v != 6) ok = 0;
    v = D_C;
    if (v != 7) ok = 0;
    v = D_D;
    if (v != 102) ok = 0;
    u32 c = GREEN;
    if (c != GREEN) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
