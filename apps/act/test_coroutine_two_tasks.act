// test_coroutine_two_tasks: two task records driven by the same coroutine keep separate state
// Passes with trap(0); fails with trap(15).

import "lib/protokernel.act";

type Task {
    u16 lc;
    u32 count;
};

u32 ticker(Task t) {
    while (1) {
        t.count += 1;
        yield(t, 1);
    }
}

void main() {
    u32 ok = 1;
    Task a;
    Task b;
    u32 s = ticker(a);
    s = ticker(a);
    s = ticker(b);
    s = ticker(a);
    if (a.count != 3) ok = 0;
    if (b.count != 1) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
