// test_strings_fixed: fixed string buffers: literal initialization, .len, .capacity, indexing
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    string s[16] = "hello";
    if (s.len != 5) ok = 0;
    if (s.capacity != 16) ok = 0;
    if (s[0] != 'h') ok = 0;
    if (s[4] != 'o') ok = 0;
    if (s[5] != 0) ok = 0;
    s[0] = 'j';
    if (s[0] != 'j') ok = 0;
    s[5] = '!';
    if (s.len != 6) ok = 0;
    s[2] = 0;
    if (s.len != 2) ok = 0;
    string empty[4] = "";
    if (empty.len != 0) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
