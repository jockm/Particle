// test_function_prototype: a function can be called before its definition when declared with a prototype
// Passes with trap(0); fails with trap(15).

u32 later(u32 v);

void main() {
    u32 ok = 1;
    if (later(4) != 16) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}

u32 later(u32 v) {
    return v * 4;
}
