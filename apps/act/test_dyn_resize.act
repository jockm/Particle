void main() {
    // 1. Allocate initial array of 4 u32s
    u32 arr[] = u32.createArray(4);
    arr[0] = 11;
    arr[1] = 22;
    arr[2] = 33;
    arr[3] = 44;

    if (arr.len != 4) {
        trap(15);
    }

    // 2. High-level resize to 8 elements (growing buffer)
    arr.resize(8);

    if (arr.len != 8) {
        trap(15);
    }

    // Verify existing 4 elements were preserved
    if (arr[0] != 11 || arr[1] != 22 || arr[2] != 33 || arr[3] != 44) {
        trap(15);
    }

    // Populate and verify new elements
    arr[4] = 55;
    arr[7] = 88;
    if (arr[4] + arr[7] != 143) {
        trap(15);
    }

    // 3. High-level resize to 2 elements (shrinking buffer)
    arr.resize(2);

    if (arr.len != 2) {
        trap(15);
    }

    if (arr[0] != 11 || arr[1] != 22) {
        trap(15);
    }

    // 4. Clean up
    arr.destroy();

    // Verification passed
    trap(0);
}
