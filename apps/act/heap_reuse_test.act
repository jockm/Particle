type Item {
    u32 id;
    u32 value;
};

void main() {
    // 1. Allocate two items
    Item a = Item.create();
    a.id = 10;
    a.value = 20;

    Item b = Item.create();
    b.id = 30;
    b.value = 40;

    // 2. Free the first item (creates a free list node of 16 bytes chunk size)
    a.destroy();

    // 3. Allocate a third item - must reuse chunk 'a'
    Item c = Item.create();
    c.id = 100;
    c.value = 200;

    // 4. Verify values of b and c
    if (b.id != 30 || b.value != 40) {
        trap(15);
    }
    if (c.id != 100 || c.value != 200) {
        trap(15);
    }

    c.destroy();
    b.destroy();

    trap(14);
}
