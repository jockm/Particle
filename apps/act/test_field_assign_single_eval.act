// test_field_assign_single_eval: the right side of a field assignment is evaluated once
// Passes with trap(0); fails with trap(15).

type Box {
    u32 v;
};

u32 calls = 0;

u32 next() {
    calls += 1;
    return calls;
}

void main() {
    u32 ok = 1;
    Box b;
    b.v = next();
    if (calls != 1) ok = 0;
    if (b.v != 1) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
