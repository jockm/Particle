// Test primitive string capabilities: .capacity, param .len dereferencing, and sentinel overwrite safety

type Header {
    u32 id;
    string title[24];
};

u32 test_param_len(string s) {
    return s.len;
}

u32 test_param_cap(string s) {
    return s.capacity;
}

void main() {
    string msg[16] = "Particle";
    
    // 1. Verify capacity & initial length
    if (msg.capacity != 16) {
        trap(1);
    }
    if (msg.len != 8) {
        trap(2);
    }

    // 2. Verify parameter dereferencing for .len
    u32 l = test_param_len(msg);
    if (l != 8) {
        trap(3);
    }

    // 3. Verify struct/type field capacity
    Header hdr;
    if (hdr.title.capacity != 24) {
        trap(4);
    }

    // 4. In-bounds write up to capacity - 2
    msg[0] = 'p';
    msg[14] = 'X';
    if (msg[0] != 'p') {
        trap(5);
    }
    if (msg[14] != 'X') {
        trap(6);
    }

    // All checks passed
    trap(0);
}
