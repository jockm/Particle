// test_bounds_check_in_range: first and last elements are accessible with bounds checking on
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 a[5];
    u32 last = 4;
    a[0] = 1;
    a[last] = 2;
    if (a[0] != 1) ok = 0;
    if (a[last] != 2) ok = 0;
    u8 m[2][3];
    u32 r = 1;
    u32 c = 2;
    m[r][c] = 9;
    if (m[r][c] != 9) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
