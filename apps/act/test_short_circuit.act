// test_short_circuit: the right side of && and || runs only when needed
// Passes with trap(0); fails with trap(15).

u32 calls = 0;

u32 bump() {
    calls += 1;
    return 1;
}

void main() {
    u32 ok = 1;
    u32 zero = 0;
    u32 one = 1;
    if (zero != 0 && bump() == 1) ok = 0;
    if (calls != 0) ok = 0;
    if (one == 1 || bump() == 1) {
    } else {
        ok = 0;
    }
    if (calls != 0) ok = 0;
    u32 v = zero && bump();
    if (v != 0) ok = 0;
    v = one || bump();
    if (v != 1) ok = 0;
    if (calls != 0) ok = 0;
    v = one && bump();
    if (v != 1) ok = 0;
    if (calls != 1) ok = 0;
    v = zero || bump();
    if (v != 1) ok = 0;
    if (calls != 2) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
