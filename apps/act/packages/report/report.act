// The report package of test_packages: it imports another package (as
// 'geo') and the protokernel package, keeps a fast global, and imports
// ../files/counter.act as a file, which joins this package: its names are
// this package's own, not pub.
package report;

import "github.com/jockm/Particle/apps/act/packages/geometry" as geo;
import "github.com/jockm/Particle/lib/protokernel";
import "../files/counter.act";

pub fast u32 calls;

u32 steps;

// Counts the calls of runSteps: a Counter, from the file import
Counter runs;

// A task, private to this package
task stepper(protokernel.pt t) {
    while (true) {
        steps = steps + 1;
        protokernel.yield(t);
    }
}

pub u32 runSteps(u32 n) {
    runs.bump();
    protokernel.pt t;
    u32 i = 0;
    while (i < n) {
        stepper(t);
        i = i + 1;
    }
    return steps;
}

// The area of r, counting the call; the prelude's string methods work here
pub u32 summarize(geo.Rect r) {
    calls = calls + 1;
    string name[8] = "rect";
    if (name.find(114) != 0) {
        return 0;
    }
    return r.area();
}
