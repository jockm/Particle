// test_coroutine: task functions with yield, wait_until and pk_exit from
// lib/protokernel.act. Checks the returned status values, resuming at the
// right point, pk_exit restarting the task, resuming inside while and switch
// bodies, 'return;' ending a task, tasks as function values, and a task
// with a parameter besides its state.
// Passes with trap(0); fails with trap(15).

import "lib/protokernel.act";

u32 g_trace = 0;
u32 g_ready = 0;
u32 g_mode = 0;

task steps(type pt p) {
    g_trace = g_trace * 10 + 1;
    yield(p);
    g_trace = g_trace * 10 + 2;
    wait_until(p, g_ready == 1);
    g_trace = g_trace * 10 + 3;
    if (g_mode == 1) {
        pk_exit(p);
    }
    g_trace = g_trace * 10 + 4;
}

type Counter {
    u16 lc;
    u32 i;          // the loop counter lives in the task's state
};

task in_loop(Counter c) {
    while (c.i < 2) {
        g_trace = g_trace * 10 + 5;
        yield(c);
        g_trace = g_trace * 10 + 6;
        c.i += 1;
    }
}

// 'return;' ends the task: the counter resets and the status is PK_ENDED
task early(type pt p) {
    g_trace = g_trace * 10 + 1;
    yield(p);
    if (g_mode == 2) {
        return;
    }
    g_trace = g_trace * 10 + 2;
    yield(p);
}

// A parameter besides the state is passed fresh on every call
task adder(type pt p, u32 amount) {
    g_trace += amount;
    yield(p);
    g_trace += amount * 10;
}

type Task = fn(pt) -> u16;

task in_switch(type pt p) {
    switch (g_mode) {
        case 7:
            g_trace = g_trace * 10 + 7;
            yield(p);
            g_trace = g_trace * 10 + 8;
        default:
            g_trace = g_trace * 10 + 9;
    }
}

void main() {
    u32 ok = 1;
    type pt t;
    pk_init(t);

    if (steps(t) != PK_YIELDED) ok = 0;      // trace 1
    if (steps(t) != PK_WAITING) ok = 0;      // trace 12
    if (steps(t) != PK_WAITING) ok = 0;      // still waiting, no trace
    g_ready = 1;
    if (steps(t) != PK_ENDED) ok = 0;        // trace 1234
    if (g_trace != 1234) ok = 0;
    if (t.lc != 0) ok = 0;

    // pk_exit: the next call starts again from the top
    g_trace = 0;
    g_mode = 1;
    steps(t);                                // 1
    if (steps(t) != PK_EXITED) ok = 0;       // 123 (ready is still 1)
    if (t.lc != 0) ok = 0;
    if (steps(t) != PK_YIELDED) ok = 0;      // 1231
    if (g_trace != 1231) ok = 0;

    // Resume inside a while body
    g_trace = 0;
    Counter c;
    if (in_loop(c) != PK_YIELDED) ok = 0;    // 5
    if (in_loop(c) != PK_YIELDED) ok = 0;    // 565
    if (in_loop(c) != PK_ENDED) ok = 0;      // 5656
    if (g_trace != 5656 || c.lc != 0) ok = 0;

    // 'return;' ends the task
    g_trace = 0;
    g_mode = 2;
    pk_init(t);
    if (early(t) != PK_YIELDED) ok = 0;      // 1
    if (early(t) != PK_ENDED) ok = 0;        // returned
    if (g_trace != 1 || t.lc != 0) ok = 0;

    // A task held in a function value, with a parameter
    g_trace = 0;
    pk_init(t);
    Task run = early;
    if (run(t) != PK_YIELDED) ok = 0;
    pk_init(t);
    if (adder(t, 3) != PK_YIELDED) ok = 0;   // +3
    if (adder(t, 5) != PK_ENDED) ok = 0;     // +50
    if (g_trace != 1 + 3 + 50) ok = 0;

    // Resume inside a switch case
    g_trace = 0;
    g_mode = 7;
    pk_init(t);
    if (in_switch(t) != PK_YIELDED) ok = 0;  // 7
    if (in_switch(t) != PK_ENDED) ok = 0;    // 78 (implicit break)
    if (g_trace != 78) ok = 0;

    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
