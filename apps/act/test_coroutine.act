// test_coroutine: yield, wait_until and pk_exit from lib/protokernel.act.
// Checks the returned status values, resuming at the right step, pk_exit
// restarting the coroutine, and resuming inside for and switch bodies.
// Passes with trap(0); fails with trap(15).

import "lib/protokernel.act";

u32 g_trace = 0;
u32 g_ready = 0;
u32 g_mode = 0;

u16 steps(type pt p) {
    g_trace = g_trace * 10 + 1;
    yield(p, 1);
    g_trace = g_trace * 10 + 2;
    wait_until(p, 2, g_ready == 1);
    g_trace = g_trace * 10 + 3;
    if (g_mode == 1) {
        pk_exit(p);
    }
    g_trace = g_trace * 10 + 4;
}

u16 in_loop(type pt p) {
    for (u32 i : 0..2) {
        g_trace = g_trace * 10 + 5;
        yield(p, 1);
        g_trace = g_trace * 10 + 6;
        break;
    }
}

u16 in_switch(type pt p) {
    switch (g_mode) {
        case 7:
            g_trace = g_trace * 10 + 7;
            yield(p, 1);
            g_trace = g_trace * 10 + 8;
        default:
            g_trace = g_trace * 10 + 9;
    }
}

void main() {
    u32 ok = 1;
    type pt t;
    pk_init(t);

    if (steps(t) != PK_YIELDED) ok = 0;      // trace 1
    if (steps(t) != PK_WAITING) ok = 0;      // trace 12
    if (steps(t) != PK_WAITING) ok = 0;      // still waiting, no trace
    g_ready = 1;
    if (steps(t) != PK_ENDED) ok = 0;        // trace 1234
    if (g_trace != 1234) ok = 0;
    if (t.lc != 0) ok = 0;

    // pk_exit: the next call starts again from the top
    g_trace = 0;
    g_mode = 1;
    steps(t);                                // 1
    if (steps(t) != PK_EXITED) ok = 0;       // 123 (ready is still 1)
    if (t.lc != 0) ok = 0;
    if (steps(t) != PK_YIELDED) ok = 0;      // 1231
    if (g_trace != 1231) ok = 0;

    // Resume inside a for body
    g_trace = 0;
    pk_init(t);
    if (in_loop(t) != PK_YIELDED) ok = 0;    // 5
    if (in_loop(t) != PK_ENDED) ok = 0;      // 56
    if (g_trace != 56) ok = 0;

    // Resume inside a switch case
    g_trace = 0;
    g_mode = 7;
    pk_init(t);
    if (in_switch(t) != PK_YIELDED) ok = 0;  // 7
    if (in_switch(t) != PK_ENDED) ok = 0;    // 78 (implicit break)
    if (g_trace != 78) ok = 0;

    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
