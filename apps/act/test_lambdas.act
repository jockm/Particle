// test_lambdas: lambdas, named and unnamed, as variables, fields, array
// elements, arguments and results
// Passes with trap(0); fails with trap(15).

type BinOp = fn(u32, u32) -> u32;
type Pred = fn(u32) -> bool;
type Hook = fn(u32);

type Driver {
    u32 calls;
    BinOp combine;
};

u32 g_seen = 0;

u32 apply(BinOp op, u32 a, u32 b) {
    return op(a, b);
}

u32 countIf(u32 xs[], Pred p) {
    u32 n = 0;
    for (u32 i : 0..xs.len) {
        if (p(xs[i])) n += 1;
    }
    return n;
}

// A function that returns a lambda
BinOp pick(bool wantMax) {
    if (wantMax) {
        return fn(u32 a, u32 b) -> u32 {
            if (a > b) return a;
            return b;
        };
    }
    return fn(u32 a, u32 b) -> u32 {
        if (a < b) return a;
        return b;
    };
}

void main() {
    u32 ok = 1;
    const u32 LIMIT = 10;

    // In a variable, and as an argument
    BinOp add = fn(u32 a, u32 b) -> u32 { return a + b; };
    if (add(2, 3) != 5) ok = 0;
    if (apply(fn(u32 a, u32 b) -> u32 { return a * b; }, 6, 7) != 42) ok = 0;

    // It can use the constants of the function it is written in
    u32 xs[5] = {3, 12, 7, 15, 10};
    if (countIf(xs, fn(u32 v) -> bool { return v > LIMIT; }) != 2) ok = 0;

    // A named lambda can call itself
    BinOp power = fn pow(u32 b, u32 e) -> u32 {
        if (e == 0) return 1;
        return b * pow(b, e - 1);
    };
    if (power(3, 4) != 81) ok = 0;

    // A lambda that returns nothing, using a global
    Hook log = fn(u32 v) { g_seen += v; };
    log(4);
    log(5);
    if (g_seen != 9) ok = 0;

    // In a field, an array and a record's starting values
    Driver d = Driver.create(combine: fn(u32 a, u32 b) -> u32 { return a - b; });
    if (d.combine(10, 4) != 6) ok = 0;
    BinOp ops[2] = {add, fn(u32 a, u32 b) -> u32 { return a % b; }};
    if (ops[1](17, 5) != 2) ok = 0;
    d.destroy();

    // From a function, and a lambda inside a lambda
    if (pick(true)(4, 9) != 9 || pick(false)(4, 9) != 4) ok = 0;
    BinOp twice = fn(u32 a, u32 b) -> u32 {
        BinOp inner = fn(u32 x, u32 y) -> u32 { return x + y + LIMIT; };
        return inner(a, b) * 2;
    };
    if (twice(1, 2) != 26) ok = 0;

    if (ok == 1) {
        trap(0);
    }
    trap(15);
}
