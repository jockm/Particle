// test_unsigned_narrow: u8 and u16 values are truncated on store and zero-extended on load
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u8 b = 255;
    b = b + 1;
    if (b != 0) ok = 0;
    u32 wide16 = 0x1234;  // a constant that does not fit is an error
    u8 c = wide16;
    if (c != 0x34) ok = 0;
    u32 wide17 = 0x12345;
    u16 w = wide17;
    if (w != 0x2345) ok = 0;
    u16 m = 0xFFFF;
    u32 wide = m;
    if (wide != 0xFFFF) ok = 0;
    u8 top = 0x80;
    u32 t = top;
    if (t != 0x80) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
