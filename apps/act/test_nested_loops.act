// test_nested_loops: nested loops; break leaves only the innermost loop
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 total = 0;
    for (u32 i : 0..3) {
        for (u32 j : 0..4) {
            total += 1;
        }
    }
    if (total != 12) ok = 0;
    u32 inner = 0;
    u32 outer = 0;
    for (u32 a : 0..3) {
        outer += 1;
        u32 b = 0;
        while (1) {
            if (b == 2) break;
            inner += 1;
            b += 1;
        }
    }
    if (outer != 3) ok = 0;
    if (inner != 6) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
