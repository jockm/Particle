// test_nonzero_is_true: any non-zero value is true in a condition
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 five = 5;
    u32 big = 0x80000000;
    u32 zero = 0;
    u32 hits = 0;
    if (five) hits += 1;
    if (big) hits += 1;
    if (zero) hits += 100;
    if (hits != 2) ok = 0;
    if (!zero) {
    } else {
        ok = 0;
    }
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
