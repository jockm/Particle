import "lib/protokernel.act";

// Verification variables
u32 g_producer_count = 0;
u32 g_consumer_count = 0;
u32 g_shared_mailbox = 0;
u32 g_mailbox_ready  = 0;
u32 g_checksum       = 0;
u32 g_test_passed    = 0;

u16 task_producer(type pt p) {
    // Iteration 1
    g_shared_mailbox = 16;
    g_mailbox_ready = 1;
    g_producer_count += 1;
    yield(p, 1);

    // Iteration 2
    g_shared_mailbox = 32;
    g_mailbox_ready = 1;
    g_producer_count += 1;
    yield(p, 2);

    // Iteration 3
    g_shared_mailbox = 48;
    g_mailbox_ready = 1;
    g_producer_count += 1;
    yield(p, 3);

    // Iteration 4
    g_shared_mailbox = 64;
    g_mailbox_ready = 1;
    g_producer_count += 1;
    yield(p, 4);
}

u16 task_consumer(type pt p) {
    while (g_consumer_count < 4) {
        wait_until(p, 1, g_mailbox_ready == 1);

        g_checksum += g_shared_mailbox;
        g_mailbox_ready = 0;
        g_consumer_count += 1;

        yield(p, 2);
    }
}

void main() {
    type pt pt_prod;
    type pt pt_cons;

    pk_init(pt_prod);
    pk_init(pt_cons);

    while (g_consumer_count < 4) {
        task_producer(pt_prod);
        task_consumer(pt_cons);
    }

    if (g_checksum == 160) {
        if (g_producer_count == 4) {
            g_test_passed = 0xCAFE;
        }
    }

    trap(0);
}
