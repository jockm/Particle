u32 g_data[6];

u32 get_first(u32 inner[]) {
    return inner[0];
}

u32 sum_and_scale(u32 buf[], u32 scale) {
    u32 total = 0;
    u32 i = 0;
    while (i < buf.len) {
        buf[i] = buf[i] * scale;
        total = total + buf[i];
        i = i + 1;
    }
    // Verify forwarding open array parameter to another open array function
    u32 first = get_first(buf);
    return total + first;
}

void main() {
    u32 local_buf[4];

    // Initialize local array
    local_buf[0] = 1;
    local_buf[1] = 2;
    local_buf[2] = 3;
    local_buf[3] = 4;

    // sum_and_scale with scale 2:
    // Elements become: 2, 4, 6, 8 (sum = 20)
    // plus first element (2) -> returns 22
    u32 res1 = sum_and_scale(local_buf, 2);
    if (res1 != 22) {
        trap(15);
    }

    // Initialize global array
    g_data[0] = 10;
    g_data[1] = 20;
    g_data[2] = 30;
    g_data[3] = 40;
    g_data[4] = 50;
    g_data[5] = 60;

    // sum_and_scale with scale 1:
    // Elements stay: 10, 20, 30, 40, 50, 60 (sum = 210)
    // plus first element (10) -> returns 220
    u32 res2 = sum_and_scale(g_data, 1);
    if (res2 != 220) {
        trap(15);
    }

    // Pass: trigger clean exit
    trap(14);
}
