// test_function_fields: fields and array elements of function type, and
// calls through them
// Passes with trap(0); fails with trap(15).

type Op = fn(u32, u32) -> u32;
type Hook = fn(u32);

type Driver {
    u32 calls;
    Op combine;
    Op table[2];
};

u32 g_seen = 0;

u32 add(u32 a, u32 b) { return a + b; }
u32 mul(u32 a, u32 b) { return a * b; }
void note(u32 v) { g_seen += v; }

Op pick(u32 i) {
    if (i == 0) {
        return add;
    }
    return mul;
}

u32 Driver.run(u32 a, u32 b) {
    this.calls += 1;
    return this.combine(a, b);
}

// More than four arguments: the fifth goes on the stack
type Five = fn(u32, u32, u32, u32, u32) -> u32;
u32 five(u32 a, u32 b, u32 c, u32 d, u32 e) { return a + b + c + d + e * 10; }

void main() {
    u32 ok = 1;

    Driver d = Driver.create(combine: add, table: {add, mul});
    if (d.combine(2, 3) != 5) ok = 0;
    if (d.table[1](4, 5) != 20) ok = 0;
    if (d.run(6, 7) != 13 || d.calls != 1) ok = 0;
    d.combine = mul;
    if (d.run(6, 7) != 42) ok = 0;
    d.destroy();

    Op ops[2] = {mul, add};
    u32 i = 1;
    if (ops[i](10, ops[0](2, 3)) != 16) ok = 0;
    if (pick(1)(3, 3) != 9) ok = 0;

    Hook hooks[2] = {note, note};
    hooks[0](4);
    hooks[1](5);
    if (g_seen != 9) ok = 0;

    Five fs[1] = {five};
    if (fs[0](1, 2, 3, 4, 5) != 60) ok = 0;

    if (ok == 1) {
        trap(0);
    }
    trap(15);
}
