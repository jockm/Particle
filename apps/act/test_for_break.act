// test_for_break: break leaves a range for loop
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 n = 0;
    for (u32 i : 0..100) {
        if (i == 4) break;
        n += 1;
    }
    if (n != 4) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
