// test_compound_assign_array: compound assignment to array elements
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 arr[4];
    arr[2] = 4;
    arr[2] += 3;
    if (arr[2] != 7) ok = 0;
    u32 i = 1;
    arr[i] = 10;
    arr[i] *= 5;
    if (arr[i] != 50) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
