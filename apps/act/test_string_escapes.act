// test_string_escapes: escape sequences in string literals
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    string s[8] = "a\tb\n";
    if (s.len != 4) ok = 0;
    if (s[1] != 9) ok = 0;
    if (s[3] != 10) ok = 0;
    string q[8] = "\"x\\";
    if (q.len != 3) ok = 0;
    if (q[0] != '"') ok = 0;
    if (q[2] != 92) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
