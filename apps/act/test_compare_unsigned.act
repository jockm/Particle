// test_compare_unsigned: unsigned comparison operators in conditions
// Passes with trap(0); fails with trap(15).

void main() {
    u32 ok = 1;
    u32 a = 3;
    u32 b = 5;
    u32 c = 5;
    if (!(a < b)) ok = 0;
    if (b < a) ok = 0;
    if (!(b <= c)) ok = 0;
    if (b <= a) ok = 0;
    if (!(b > a)) ok = 0;
    if (a > b) ok = 0;
    if (!(b >= c)) ok = 0;
    if (a >= b) ok = 0;
    if (!(b == c)) ok = 0;
    if (a == b) ok = 0;
    if (!(a != b)) ok = 0;
    if (b != c) ok = 0;
    u32 max = 0xFFFFFFFF;
    u32 one = 1;
    if (!(max > one)) ok = 0;
    if (max < one) ok = 0;
    if (ok == 1) {
        trap(0);
    } else {
        trap(15);
    }
}
