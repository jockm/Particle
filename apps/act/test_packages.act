// test_packages: a program made of packages (apps/act/packages). Imports
// by full path, a renamed import, pub types, methods, constants, enums and
// globals, a package that imports another, a fast global and a task in a
// package, and the prelude (Integer, string methods).
// Passes with trap(0); fails with trap(15).
package main;

import "github.com/jockm/Particle/apps/act/packages/geometry";
import "github.com/jockm/Particle/apps/act/packages/report" as rep;

void main() {
    u32 ok = 1;

    geometry.Rect r;
    geometry.init(r.min, 1, 2);
    geometry.init(r.max, 4, 6);
    if (r.area() != 12) ok = 0;
    if (geometry.kindOf(r) != geometry.RECT) ok = 0;
    if (geometry.SQUARE != 11 || geometry.UNIT != 1) ok = 0;

    geometry.Point d;
    geometry.init(d, 1, 0);
    r.max.add(d);
    if (r.area() != 16 || geometry.kindOf(r) != geometry.SQUARE) ok = 0;

    // A pub global of another package can be read and written
    if (geometry.created != 3) ok = 0;
    geometry.created = 10;
    if (geometry.created != 10) ok = 0;

    if (rep.summarize(r) != 16 || rep.summarize(r) != 16) ok = 0;
    if (rep.calls != 2) ok = 0;
    if (rep.runSteps(3) != 3) ok = 0;

    // The prelude: Integer and the string methods, without an import
    if (Integer.max(geometry.UNIT, 5) != 5 || Integer.MAX_U8 != 255) ok = 0;
    string word[8] = "pkg";
    if (word.find(103) != 2 || !string.equals(word, "pkg")) ok = 0;

    if (ok == 1) {
        trap(0);
    }
    trap(15);
}
