{
  "name": "particle",
  "displayName": "Particle",
  "description": "Language support for Particle RISC assembly (pasm): syntax highlighting, errors as you type, hover, go to definition, references, rename, completion and an outline.",
  "version": "0.2.0",
  "publisher": "stufflabs",
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "particle-asm",
        "aliases": [
          "Particle Assembly",
          "pasm"
        ],
        "extensions": [
          ".pasm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "particle-asm",
        "scopeName": "source.pasm",
        "path": "./syntaxes/pasm.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "particle.pasm.restartServer",
        "title": "Restart Assembly Language Server",
        "category": "Particle"
      }
    ],
    "configuration": {
      "title": "Particle",
      "properties": {
        "particle.pasm.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the Particle assembly language server, `pasm_lsp`. Empty means: `build/tools/pasm_lsp` in the workspace folder if it is there (built by `make pasm-lsp`), otherwise `pasm_lsp` found on your `PATH`. A relative path is taken from the workspace folder."
        },
        "particle.pasm.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and the assembly language server (in the Output panel)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ --noEmit && esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap --minify",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap --watch"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/vscode": "^1.91.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vscode-languageclient": "^11.0.1"
  }
}
