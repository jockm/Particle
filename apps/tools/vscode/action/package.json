{
  "name": "action",
  "displayName": "Action",
  "description": "Language support for Action: errors as you type, hover, go to definition, completion and an outline, from the Action compiler itself.",
  "version": "0.1.0",
  "publisher": "stufflabs",
  "private": true,
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "action",
        "aliases": [
          "Action"
        ],
        "extensions": [
          ".act"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "action",
        "scopeName": "source.action",
        "path": "./syntaxes/action.tmLanguage.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "action.json",
        "url": "./schemas/action.schema.json"
      }
    ],
    "commands": [
      {
        "command": "action.restartServer",
        "title": "Restart Language Server",
        "category": "Action"
      }
    ],
    "configuration": {
      "title": "Action",
      "properties": {
        "action.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the Action language server, `action_lsp`. Empty means: `build/tools/action_lsp` in the workspace folder if it is there, otherwise `action_lsp` found on your `PATH`. A relative path is taken from the workspace folder."
        },
        "action.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and the Action language server (in the Output panel)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ --noEmit && esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap --minify",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap --watch"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/vscode": "^1.91.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vscode-languageclient": "^11.0.1"
  }
}
