{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Action",
  "scopeName": "source.action",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#type-declaration" },
    { "include": "#method-declaration" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#builtins" },
    { "include": "#function-call" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.action", "match": "//.*$" },
        { "name": "comment.block.action", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "name": "string.quoted.double.action",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.action", "match": "\\\\(x[0-9A-Fa-f]{2}|[0-7]{1,3}|.)" }
      ]
    },
    "characters": {
      "name": "string.quoted.single.action",
      "match": "'(\\\\x[0-9A-Fa-f]{2}|\\\\.|[^'\\\\])'"
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.action", "match": "\\b0x[0-9A-Fa-f]+\\b" },
        { "name": "constant.numeric.decimal.action", "match": "\\b\\d+\\b" }
      ]
    },
    "type-declaration": {
      "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.action" },
        "2": { "name": "entity.name.type.action" }
      }
    },
    "method-declaration": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\.([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.type.action" },
        "2": { "name": "entity.name.function.action" }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.action",
          "match": "\\b(if|else|while|for|return|break|continue|switch|case|default)\\b"
        },
        {
          "name": "storage.modifier.action",
          "match": "\\b(const|volatile|inline|asm|ref)\\b"
        },
        {
          "name": "storage.type.action",
          "match": "\\b(type|enum|fn|task)\\b"
        },
        {
          "name": "keyword.other.action",
          "match": "\\b(import|verify|sizeof)\\b"
        }
      ]
    },
    "types": {
      "name": "support.type.primitive.action",
      "match": "\\b(u8|s8|u16|s16|u32|s32|bool|string|void)\\b"
    },
    "constants": {
      "name": "constant.language.action",
      "match": "\\b(true|false)\\b"
    },
    "builtins": {
      "patterns": [
        { "name": "variable.language.this.action", "match": "\\bthis\\b" },
        {
          "name": "support.function.builtin.action",
          "match": "\\b(trap|readfifo|writefifo|tryreadfifo|yield|wait_until|pk_exit)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.builtin.action",
          "match": "(?<=\\.)(create|createArray|destroy|destroyArray|resize|exists|len|capacity)\\b"
        }
      ]
    },
    "function-call": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "entity.name.function.action" }
      }
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.range.action", "match": "\\.\\." },
        { "name": "keyword.operator.arrow.action", "match": "->" },
        { "name": "keyword.operator.assignment.compound.action", "match": "(\\+|-|\\*|/|%|&|\\||\\^|<<|>>)=" },
        { "name": "keyword.operator.comparison.action", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.action", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.bitwise.action", "match": "<<|>>|&|\\||\\^|~" },
        { "name": "keyword.operator.arithmetic.action", "match": "\\+|-|\\*|/|%" },
        { "name": "keyword.operator.assignment.action", "match": "=" }
      ]
    }
  }
}
