// apps/act16/tuple_test.act
// Stage 2 test: Multiple scalar returns, tuple destructuring, and wildcard discard

(u32, u32) get_pair(u32 x, u32 y) {
    return (x + 10, y + 20);
}

(u32, u32, u32) get_triple(u32 a, u32 b, u32 c) {
    return (a * 2, b * 3, c * 4);
}

(u32, u32, u32, u32) get_quad(u32 a, u32 b, u32 c, u32 d) {
    return (a + 1, b + 2, c + 3, d + 4);
}

void main() {
    // 1. Destructuring with variable declarations
    (u32 p1, u32 p2) = get_pair(5, 10);
    if (p1 != 15) {
        trap(15);
    }
    if (p2 != 30) {
        trap(15);
    }

    // 2. Destructuring into existing local variables
    u32 ex1 = 0;
    u32 ex2 = 0;
    (ex1, ex2) = get_pair(100, 200);
    if (ex1 != 110) {
        trap(15);
    }
    if (ex2 != 220) {
        trap(15);
    }

    // 3. Wildcard discarding second element
    (u32 first_only, _) = get_pair(50, 75);
    if (first_only != 60) {
        trap(15);
    }

    // 4. Wildcard discarding first element
    (_, u32 second_only) = get_pair(80, 95);
    if (second_only != 115) {
        trap(15);
    }

    // 5. 3-element tuple with middle wildcard
    (u32 t_a, _, u32 t_c) = get_triple(10, 20, 30);
    if (t_a != 20) {
        trap(15);
    }
    if (t_c != 120) {
        trap(15);
    }

    // 6. 4-element tuple (Particle ABI R1-R4) with multiple wildcards
    (_, u32 q_b, _, u32 q_d) = get_quad(1, 2, 3, 4);
    if (q_b != 4) {
        trap(15);
    }
    if (q_d != 8) {
        trap(15);
    }

    // Success
    trap(14);
}
