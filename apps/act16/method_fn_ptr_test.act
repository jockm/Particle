type Calculator {
    u32 base;
};

type CalcMethod = fn(Calculator, u32) -> u32;

u32 Calculator.add(u32 val) {
    return this.base + val;
}

void main() {
    Calculator calc;
    calc.base = 100;

    // Unbound method reference assigned to strict fn(...) alias
    CalcMethod op = Calculator.add;

    // Indirect call passing receiver explicitly
    u32 res = op(calc, 50);

    if (res == 150) {
        trap(14);
    } else {
        trap(15);
    }
}
