// Define Rect before Point to verify out-of-order topological layout resolution
type Rect {
    Point origin;
    Point extent;
};

type Point {
    s32 x;
    s32 y;
};

type Window {
    u32 id;
    Rect frame;
    u32 flags;
};

void main() {
    Window win;

    win.id = 101;
    win.flags = 0xAA;

    // Direct nested member assignment
    win.frame.origin.x = 25;
    win.frame.origin.y = 50;
    win.frame.extent.x = 640;
    win.frame.extent.y = 480;

    // Chained compound assignment
    win.frame.origin.x += 15;  // 25 + 15 = 40
    win.frame.origin.y += 10;  // 50 + 10 = 60

    // Read and verify
    if (win.id != 101) {
        trap(15);
    }
    if (win.flags != 0xAA) {
        trap(15);
    }
    if (win.frame.origin.x != 40) {
        trap(15);
    }
    if (win.frame.origin.y != 60) {
        trap(15);
    }
    if (win.frame.extent.x != 640) {
        trap(15);
    }
    if (win.frame.extent.y != 480) {
        trap(15);
    }

    // Success
    trap(14);
}
